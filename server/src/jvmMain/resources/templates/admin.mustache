{{> header}}
<h1>Admin</h1>
<form action="/logout" method="get">
	<button type="submit">Log out</button>
</form>
<p>{{msg.language}}</p>
<p>{{msg.test.test}}</p>
<p>{{message}}</p>
<p>{{isAdmin}}</p>

<section>
	<h2>Server Message</h2>
	<p><em>This message is read from the server configuration file and cannot be edited here.</em></p>
	<pre
		style="white-space: pre-wrap; padding: 0.5rem; background: #f6f8fa; border: 1px solid #e1e4e8; border-radius: 6px;">{{serverMessage}}</pre>
</section>

