import kotlin.time.Instant;

-- uuid is declared TEXT for SqlDelight's parser; promoted to UUID at runtime
-- by PostgresSchemaInitializer (matches project.uuid). Callers cast bound
-- String parameters with CAST(:uuid AS UUID) because Postgres won't auto-cast
-- text against a UUID column in comparisons or against the UNIQUE index.
CREATE TABLE deleted_project (
    user_id BIGINT NOT NULL,
    uuid TEXT NOT NULL,
    deleted_at TIMESTAMPTZ AS Instant NOT NULL DEFAULT NOW(),
    FOREIGN KEY(user_id) REFERENCES account(id) ON DELETE CASCADE
);

CREATE INDEX deleted_project_user_id_idx ON deleted_project (user_id);

getDeletedProjects:
SELECT *
FROM deleted_project
WHERE user_id = :userId;

addDeletedProject:
INSERT INTO deleted_project(user_id, uuid)
VALUES(:userId, CAST(:uuid AS UUID));

removeDeletedProject:
DELETE FROM deleted_project
WHERE user_id = :userId AND uuid = CAST(:uuid AS UUID);

hasDeletedProject:
SELECT EXISTS(SELECT 1 FROM deleted_project WHERE user_id = :userId AND uuid = CAST(:uuid AS UUID));

deleteAllForUser:
DELETE FROM deleted_project WHERE user_id = :userId;
