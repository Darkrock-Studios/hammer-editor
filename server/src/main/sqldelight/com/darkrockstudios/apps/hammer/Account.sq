import kotlinx.datetime.Instant;

-- email and pen_name columns are declared TEXT here for SqlDelight's parser,
-- and promoted to CITEXT in PostgresSchemaPostInit so comparisons and the
-- UNIQUE indexes below become case-insensitive automatically.
CREATE TABLE account(
    id BIGSERIAL PRIMARY KEY,
    email TEXT NOT NULL,
    pen_name TEXT,
    password_hash TEXT NOT NULL,
    cipher_secret TEXT NOT NULL,
    created TIMESTAMPTZ AS Instant NOT NULL DEFAULT NOW(),
    is_admin BOOLEAN NOT NULL DEFAULT FALSE,
    last_sync TIMESTAMPTZ AS Instant NOT NULL DEFAULT NOW(),
    bio TEXT,
    email_verified BOOLEAN NOT NULL DEFAULT FALSE,
    community_member BOOLEAN NOT NULL DEFAULT FALSE,
    CONSTRAINT account_email_shape CHECK (email LIKE '%@%.%'),
    CONSTRAINT account_bio_len CHECK (bio IS NULL OR length(bio) <= 10000),
    CONSTRAINT account_pen_name_len CHECK (pen_name IS NULL OR length(pen_name) BETWEEN 1 AND 64)
);

CREATE UNIQUE INDEX account_email_unique ON account (email);
CREATE UNIQUE INDEX account_pen_name_unique ON account (pen_name) WHERE pen_name IS NOT NULL;
CREATE INDEX account_community_idx ON account (id) WHERE community_member = TRUE;

getAllAccount:
SELECT *
FROM account;

getAccount:
SELECT *
FROM account
WHERE id = ?;

getLastSync:
SELECT last_sync
FROM account
WHERE id = ?;

updateLastSync:
UPDATE account
SET last_sync = :newSyncTime
WHERE id = :userId;

findAccount:
SELECT *
FROM account
WHERE email = ?;

count:
SELECT COUNT(*) FROM account;

createAccount:
INSERT INTO account(email, password_hash, cipher_secret, is_admin)
VALUES (?, ?, ?, ?);

testInsertAccount:
INSERT INTO account(email, password_hash, cipher_secret, is_admin, created, last_sync)
VALUES (?, ?, ?, ?, ?, ?);

setAdmin:
UPDATE account SET is_admin = ? WHERE id = ?;

updatePenName:
UPDATE account SET pen_name = ? WHERE id = ?;

findAccountByPenName:
SELECT *
FROM account
WHERE pen_name = ?;

isPenNameTaken:
SELECT COUNT(*) > 0
FROM account
WHERE pen_name = ? AND (:excludeUserId IS NULL OR id != :excludeUserId);

migration_setCipherSecret:
UPDATE account SET cipher_secret = :cipherSecret WHERE id = :id;

getAccountsPaginated:
SELECT id, email, pen_name, created, last_sync
FROM account
ORDER BY created DESC
LIMIT :limit OFFSET :offset;

getAccountsPaginatedSortByCreated:
SELECT a.id, a.email, a.pen_name, a.created, a.last_sync,
       COALESCE((SELECT MAX(p.last_sync) FROM project p WHERE p.user_id = a.id), a.last_sync) AS most_recent_sync,
       COALESCE((SELECT COUNT(*) FROM project p WHERE p.user_id = a.id), 0) AS project_count
FROM account a
ORDER BY CASE WHEN :ascending = 1 THEN a.created END ASC,
         CASE WHEN :ascending = 0 THEN a.created END DESC
LIMIT :limit OFFSET :offset;

getAccountsPaginatedSortByLastSync:
SELECT a.id, a.email, a.pen_name, a.created, a.last_sync,
       COALESCE((SELECT MAX(p.last_sync) FROM project p WHERE p.user_id = a.id), a.last_sync) AS most_recent_sync,
       COALESCE((SELECT COUNT(*) FROM project p WHERE p.user_id = a.id), 0) AS project_count
FROM account a
ORDER BY CASE WHEN :ascending = 1 THEN COALESCE((SELECT MAX(p.last_sync) FROM project p WHERE p.user_id = a.id), a.last_sync) END ASC,
         CASE WHEN :ascending = 0 THEN COALESCE((SELECT MAX(p.last_sync) FROM project p WHERE p.user_id = a.id), a.last_sync) END DESC
LIMIT :limit OFFSET :offset;

getAccountsPaginatedSortByProjectCount:
SELECT a.id, a.email, a.pen_name, a.created, a.last_sync,
       COALESCE((SELECT MAX(p.last_sync) FROM project p WHERE p.user_id = a.id), a.last_sync) AS most_recent_sync,
       COALESCE((SELECT COUNT(*) FROM project p WHERE p.user_id = a.id), 0) AS project_count
FROM account a
ORDER BY CASE WHEN :ascending = 1 THEN COALESCE((SELECT COUNT(*) FROM project p WHERE p.user_id = a.id), 0) END ASC,
         CASE WHEN :ascending = 0 THEN COALESCE((SELECT COUNT(*) FROM project p WHERE p.user_id = a.id), 0) END DESC,
         a.created DESC
LIMIT :limit OFFSET :offset;

updatePassword:
UPDATE account SET password_hash = ? WHERE id = ?;

updateBio:
UPDATE account SET bio = ? WHERE id = ?;

getBio:
SELECT bio FROM account WHERE id = ?;

updateCommunityMember:
UPDATE account SET community_member = ? WHERE id = ?;

getCommunityMember:
SELECT community_member FROM account WHERE id = ?;

getCommunityAuthors:
SELECT id, pen_name, bio, created
FROM account
WHERE community_member = TRUE AND pen_name IS NOT NULL
ORDER BY pen_name ASC
LIMIT :limit OFFSET :offset;

countCommunityAuthors:
SELECT COUNT(*)
FROM account
WHERE community_member = TRUE AND pen_name IS NOT NULL;
