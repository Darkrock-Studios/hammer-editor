import kotlin.time.Instant;

-- date_added was Unix-seconds INTEGER in SQLite; promoted to TIMESTAMPTZ here.
-- email is declared TEXT for SqlDelight's parser; PostgresSchemaPostInit
-- promotes it to CITEXT for case-insensitive lookups.
-- A NULL `expires` never expires.
CREATE TABLE white_list(
    email TEXT NOT NULL PRIMARY KEY,
    date_added TIMESTAMPTZ AS Instant NOT NULL DEFAULT NOW(),
    reason TEXT DEFAULT '',
    expires TIMESTAMPTZ AS Instant
);

CREATE INDEX white_list_expires_idx ON white_list (expires);

-- Bound parameters for the CITEXT `email` column are cast explicitly so the
-- comparison goes through the citext-equality operator (case-insensitive)
-- rather than being narrowed to text-equality. See Account.sq:findAccount.
-- Expiry is enforced here, not by WhitelistExpiryJob's reaping, so an entry stops
-- authorizing the instant it expires no matter when the job last ran. `now` is bound
-- from the injected Clock so expiry tracks the server's clock, not the database's.
isWhiteListed:
SELECT EXISTS
(SELECT 1
 FROM white_list
 WHERE email = CAST(? AS CITEXT)
   AND (expires IS NULL OR expires > ?));

-- Re-adding an existing email renews it, so an admin can extend or clear an expiry
-- by adding the address again.
addToWhiteList:
INSERT INTO white_list(email, date_added, reason, expires)
VALUES (CAST(? AS CITEXT), ?, ?, ?)
ON CONFLICT (email) DO UPDATE
SET reason = EXCLUDED.reason,
    expires = EXCLUDED.expires;

-- DO NOTHING rather than addToWhiteList's upsert: existing entries (Patreon,
-- expiring invites) must keep their reason and expiry.
backfillFromAccounts:
INSERT INTO white_list(email, date_added, reason, expires)
SELECT a.email, ?, ?, NULL
FROM account a
WHERE a.deleted_at IS NULL
ON CONFLICT (email) DO NOTHING;

removeFromWhiteList:
DELETE FROM white_list
WHERE email = CAST(? AS CITEXT);

getAll:
SELECT * FROM white_list
ORDER BY email ASC;

-- Every paginated query breaks ties on email. backfillFromAccounts stamps all the rows
-- it migrates with one timestamp, so date_added alone leaves LIMIT/OFFSET free to repeat
-- and skip entries across pages.
getPaginated:
SELECT * FROM white_list
ORDER BY date_added DESC, email ASC
LIMIT ? OFFSET ?;

getPaginatedOldestFirst:
SELECT * FROM white_list
ORDER BY date_added ASC, email ASC
LIMIT ? OFFSET ?;

getPaginatedWithAccountStatus:
SELECT w.*, (a.email IS NOT NULL) AS has_account
FROM white_list w
LEFT JOIN account a ON w.email = a.email
ORDER BY w.date_added DESC, w.email ASC
LIMIT ? OFFSET ?;

getPaginatedWithAccountStatusOldestFirst:
SELECT w.*, (a.email IS NOT NULL) AS has_account
FROM white_list w
LEFT JOIN account a ON w.email = a.email
ORDER BY w.date_added ASC, w.email ASC
LIMIT ? OFFSET ?;

-- Admin email search. A wildcard match can't ride the citext equality operator, so both
-- sides are narrowed to text and matched with ILIKE, which is unambiguously
-- case-insensitive. The repository escapes % and _ in the admin's input before binding.
searchPaginatedWithAccountStatus:
SELECT w.*, (a.email IS NOT NULL) AS has_account
FROM white_list w
LEFT JOIN account a ON w.email = a.email
WHERE CAST(w.email AS TEXT) ILIKE ?
ORDER BY w.date_added DESC, w.email ASC
LIMIT ? OFFSET ?;

searchPaginatedWithAccountStatusOldestFirst:
SELECT w.*, (a.email IS NOT NULL) AS has_account
FROM white_list w
LEFT JOIN account a ON w.email = a.email
WHERE CAST(w.email AS TEXT) ILIKE ?
ORDER BY w.date_added ASC, w.email ASC
LIMIT ? OFFSET ?;

getCount:
SELECT count(*) FROM white_list;

searchCount:
SELECT count(*) FROM white_list
WHERE CAST(email AS TEXT) ILIKE ?;

getByEmail:
SELECT * FROM white_list WHERE email = CAST(? AS CITEXT);

getByReason:
SELECT * FROM white_list WHERE reason = ?;

countByReasonWithAccounts:
SELECT COUNT(*)
FROM white_list w
INNER JOIN account a ON w.email = a.email
WHERE w.reason = ?;

updateReason:
UPDATE white_list
SET reason = ?
WHERE email = CAST(? AS CITEXT);

updateExpiry:
UPDATE white_list
SET expires = ?
WHERE email = CAST(? AS CITEXT);

-- A NULL `expires` never matches `<= ?`, so never-expiring entries are excluded
-- without an IS NOT NULL guard — which would narrow the projection's nullability and
-- stop it generating as the shared White_list type.
selectExpired:
SELECT * FROM white_list
WHERE expires <= ?;

deleteExpired:
DELETE FROM white_list
WHERE expires <= ?;
