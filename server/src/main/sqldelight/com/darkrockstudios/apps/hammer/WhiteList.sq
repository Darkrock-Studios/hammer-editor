CREATE TABLE white_list(
    email TEXT NOT NULL PRIMARY KEY,
    date_added INTEGER NOT NULL DEFAULT 0,
    reason TEXT DEFAULT ''
);

isWhiteListed:
SELECT EXISTS
(SELECT 1
 FROM white_list
 WHERE email = ?);

addToWhiteList:
INSERT OR IGNORE
INTO white_list(email, date_added, reason) VALUES (?, ?, ?);

removeFromWhiteList:
DELETE FROM white_list
WHERE email = ?;

getAll:
SELECT * FROM white_list
ORDER BY email ASC;

getPaginated:
SELECT * FROM white_list
ORDER BY email ASC
LIMIT ? OFFSET ?;

getCount:
SELECT count(*) FROM white_list;

getByReason:
SELECT * FROM white_list WHERE reason = ?;

countByReasonWithAccounts:
SELECT COUNT(*)
FROM white_list w
INNER JOIN account a ON w.email = a.email
WHERE w.reason = ?;