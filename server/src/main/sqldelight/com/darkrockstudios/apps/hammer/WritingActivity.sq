CREATE TABLE writing_activity (
    user_id BIGINT NOT NULL,
    project_id BIGINT NOT NULL,
    device_id TEXT NOT NULL CHECK (device_id != ''),
    content TEXT NOT NULL,
    FOREIGN KEY(user_id) REFERENCES account(id) ON DELETE CASCADE,
    FOREIGN KEY(project_id) REFERENCES project(id) ON DELETE CASCADE,
    UNIQUE(user_id, project_id, device_id)
);

CREATE INDEX writing_activity_user_project_idx ON writing_activity (user_id, project_id);

getAllForProject:
SELECT device_id, content
FROM writing_activity
WHERE user_id = :userId AND project_id = :projectId;

upsertDeviceLog:
INSERT INTO writing_activity(user_id, project_id, device_id, content)
VALUES (:userId, :projectId, :deviceId, :content)
ON CONFLICT (user_id, project_id, device_id) DO UPDATE SET
    content = EXCLUDED.content;

deleteAllForUser:
DELETE FROM writing_activity WHERE user_id = :userId;
