import kotlinx.datetime.Instant;

-- Raw login attempts, used for brute-force visibility on the Security page.
-- `email` is stored lower-cased by the repository for stable counting; it may
-- not correspond to a real account. `ip_address` is the most PII-sensitive
-- field and is only written when MonitoringConfig.storeLoginIp is enabled; the
-- whole table is purged on the loginAttemptRetentionDays window.
CREATE TABLE login_attempt (
    id BIGSERIAL PRIMARY KEY,
    email TEXT,
    ip_address TEXT,
    success BOOLEAN NOT NULL,
    attempted_at TIMESTAMPTZ AS Instant NOT NULL DEFAULT NOW()
);

CREATE INDEX login_attempt_email_time ON login_attempt(email, attempted_at);
CREATE INDEX login_attempt_time ON login_attempt(attempted_at);

recordAttempt:
INSERT INTO login_attempt(email, ip_address, success, attempted_at)
VALUES (?, ?, ?, ?);

countRecentFailuresByEmail:
SELECT count(*) FROM login_attempt
WHERE email = ? AND success = FALSE AND attempted_at > ?;

getRecentAttempts:
SELECT * FROM login_attempt
ORDER BY attempted_at DESC
LIMIT ? OFFSET ?;

-- Accounts with the most failed logins in a window — the brute-force signal.
getTopFailingEmails:
SELECT email, count(*) AS failures
FROM login_attempt
WHERE success = FALSE AND email IS NOT NULL AND attempted_at >= ?
GROUP BY email
ORDER BY failures DESC
LIMIT ?;

-- Accounts crossing the brute-force failure threshold in the window. Returns
-- every breaching row (no LIMIT) so the alert path can't truncate a real hit.
getBruteForceEmails:
SELECT email, count(*) AS failures
FROM login_attempt
WHERE success = FALSE AND email IS NOT NULL AND attempted_at >= ?
GROUP BY email
HAVING count(*) >= ?;

-- IPs crossing a brute-force threshold (high failure volume OR many distinct
-- accounts — the credential-stuffing / spray signal). HAVING applies the
-- thresholds in-query so a low-volume spray can't be hidden behind a LIMIT.
getBruteForceIps:
SELECT ip_address, count(*) AS failures, count(DISTINCT email) AS accounts
FROM login_attempt
WHERE success = FALSE AND ip_address IS NOT NULL AND attempted_at >= ?
GROUP BY ip_address
HAVING count(*) >= ? OR count(DISTINCT email) >= ?;

deleteAttemptsBefore:
DELETE FROM login_attempt WHERE attempted_at < ?;
