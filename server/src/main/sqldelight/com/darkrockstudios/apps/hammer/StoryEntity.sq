CREATE TABLE story_entity (
    user_id BIGINT NOT NULL,
    project_id BIGINT NOT NULL,
    id BIGINT NOT NULL,
    type TEXT NOT NULL,
    content TEXT NOT NULL,
    hash TEXT NOT NULL,
    cipher TEXT,
    -- 64 MiB; must match MAX_ENTITY_CONTENT_LENGTH in ProjectEntityDatabaseDatasource.
    CONSTRAINT story_entity_content_max CHECK (length(content) <= 67108864),
    FOREIGN KEY(user_id) REFERENCES account(id) ON DELETE CASCADE,
    FOREIGN KEY(project_id) REFERENCES project(id) ON DELETE CASCADE,
    UNIQUE(user_id, project_id, id)
);

CREATE INDEX entity_def_by_type ON story_entity (user_id, project_id, type);
CREATE INDEX story_entity_pagination ON story_entity (project_id, id);

getEntity:
SELECT *
FROM story_entity
WHERE user_id = :userId AND project_id = :projectId AND id = :id
LIMIT 1;

getEntityHash:
SELECT hash
FROM story_entity
WHERE user_id = :userId AND project_id = :projectId AND id = :id
LIMIT 1;

getEntityHashes:
SELECT id, hash
FROM story_entity
WHERE user_id = :userId AND project_id = :projectId
ORDER BY id;

getEntityHashesByType:
SELECT id, hash
FROM story_entity
WHERE user_id = :userId AND project_id = :projectId AND type = :type
ORDER BY id;

getAllEntities:
SELECT *
FROM story_entity
WHERE user_id = :userId AND project_id = :projectId
ORDER BY id;

getEntityDefs:
SELECT id, type
FROM story_entity
WHERE user_id = :userId AND project_id = :projectId
ORDER BY id;

getEntityDefsByType:
SELECT id, type
FROM story_entity
WHERE user_id = :userId AND project_id = :projectId AND type = :type
ORDER BY id;

findMaxEntityId:
SELECT MAX(id)
FROM story_entity
WHERE user_id = :userId AND project_id = :projectId;

countEncrypted:
SELECT COUNT(*) FROM story_entity WHERE cipher IS NOT NULL AND cipher != 'none';

-- Convergence: a row needs re-crypting when its normalized tag differs from the
-- target. NULL means plaintext ('none'); the legacy 'AES/GCM/NoPadding' tag is
-- the v1 key, so it is already at target when the target is aesgcm:v1 (no churn
-- for servers upgrading from before key ids).
countForConvergence:
SELECT COUNT(*) FROM story_entity
WHERE (CASE WHEN cipher IS NULL THEN 'none'
            WHEN cipher = 'AES/GCM/NoPadding' THEN 'aesgcm:v1'
            ELSE cipher END) != :target;

-- Distinct normalized cipher tags present, so key pruning can tell which key
-- generations still protect rows. Same normalization as convergence.
distinctCiphers:
SELECT DISTINCT (CASE WHEN cipher IS NULL THEN 'none'
            WHEN cipher = 'AES/GCM/NoPadding' THEN 'aesgcm:v1'
            ELSE cipher END) AS cipher FROM story_entity;

selectForConvergence:
SELECT user_id, project_id, id, content, cipher FROM story_entity
WHERE (CASE WHEN cipher IS NULL THEN 'none'
            WHEN cipher = 'AES/GCM/NoPadding' THEN 'aesgcm:v1'
            ELSE cipher END) != :target
LIMIT :batchLimit;

-- Ordered + offset paging for the read-only dry-run, which never writes and so
-- can't rely on the predicate advancing the way convergence does.
selectForConvergencePaged:
SELECT user_id, project_id, id, content, cipher FROM story_entity
WHERE (CASE WHEN cipher IS NULL THEN 'none'
            WHEN cipher = 'AES/GCM/NoPadding' THEN 'aesgcm:v1'
            ELSE cipher END) != :target
ORDER BY user_id, project_id, id
LIMIT :batchLimit OFFSET :offset;

updateContentCipher:
UPDATE story_entity SET content = :content, cipher = :cipher
WHERE user_id = :userId AND project_id = :projectId AND id = :id;

checkExists:
SELECT EXISTS(
    SELECT 1 FROM story_entity
    WHERE user_id = :userId AND project_id = :projectId AND id = :id
);

getType:
SELECT type FROM story_entity WHERE user_id = :userId AND project_id = :projectId AND id = :id;

insertNew:
INSERT INTO story_entity(user_id, project_id, id, type, content, hash, cipher)
VALUES (:userId, :projectId, :id, :type, :content, :hash, :cipher);

update:
UPDATE story_entity
SET content = :content, hash = :hash, cipher = :cipher
WHERE user_id = :userId AND project_id = :projectId AND id = :id;

updateHash:
UPDATE story_entity
SET hash = :hash
WHERE user_id = :userId AND project_id = :projectId AND id = :id;

deleteEntity:
DELETE FROM story_entity
WHERE user_id = :userId AND project_id = :projectId AND id = :id;

deleteAllForProject:
DELETE FROM story_entity
WHERE user_id = :userId AND project_id = :projectId;

deleteAllForUser:
DELETE FROM story_entity WHERE user_id = :userId;
