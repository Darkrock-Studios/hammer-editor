import kotlinx.datetime.Instant;

CREATE TABLE project_access (
    id BIGSERIAL PRIMARY KEY,
    project_id BIGINT NOT NULL,
    access_password TEXT,
    expires_at TIMESTAMPTZ AS Instant,
    published_at TIMESTAMPTZ AS Instant NOT NULL DEFAULT NOW(),
    CONSTRAINT project_access_expires_after_published CHECK (expires_at IS NULL OR expires_at > published_at),
    FOREIGN KEY(project_id) REFERENCES project(id) ON DELETE CASCADE
);

CREATE INDEX idx_project_access_project_id ON project_access (project_id);
CREATE INDEX idx_project_access_active_expires ON project_access (expires_at) WHERE expires_at IS NOT NULL;

getAccessForProject:
SELECT *
FROM project_access
WHERE project_id = :projectId;

getAllAccessForProject:
SELECT *
FROM project_access
WHERE project_id = :projectId;

getPublicAccessForProject:
SELECT *
FROM project_access
WHERE project_id = :projectId AND access_password IS NULL
LIMIT 1;

getPrivateAccessForProject:
SELECT *
FROM project_access
WHERE project_id = :projectId AND access_password IS NOT NULL;

insertAccess:
INSERT INTO project_access(project_id, access_password, expires_at)
VALUES (?, ?, ?);

-- The SQLite `INSERT OR REPLACE` here had no UNIQUE other than PK (id auto-incr)
-- so it was effectively a plain INSERT in practice; preserve that semantics.
updateAccess:
INSERT INTO project_access(project_id, access_password, expires_at)
VALUES (?, ?, ?);

deleteAccess:
DELETE FROM project_access
WHERE project_id = :projectId;

deleteAccessById:
DELETE FROM project_access
WHERE id = :accessId;

deletePublicAccessForProject:
DELETE FROM project_access
WHERE project_id = :projectId AND access_password IS NULL;

deleteAllAccessForUser:
DELETE FROM project_access
WHERE project_id IN (
    SELECT id FROM project WHERE user_id = :userId
);

-- account.pen_name and project.name are promoted to CITEXT at runtime, so
-- equality is case-insensitive — but bound text/varchar parameters route
-- through `text = text` unless explicitly cast. CAST(:x AS CITEXT) forces
-- the citext-equality operator. See Account.sq:findAccount for the same
-- pattern applied to email.
findPublicProjectByPenNameAndProjectName:
SELECT
    project.uuid AS project_uuid,
    project.user_id,
    project.name AS project_name,
    account.pen_name,
    project_access.expires_at
FROM project
INNER JOIN account ON project.user_id = account.id
INNER JOIN project_access ON project.id = project_access.project_id
WHERE account.pen_name = CAST(:penName AS CITEXT)
  AND project.name = CAST(:projectName AS CITEXT)
  AND project_access.access_password IS NULL;

findProjectByPenNameProjectNameAndPassword:
SELECT
    project.uuid AS project_uuid,
    project.user_id,
    project.name AS project_name,
    account.pen_name,
    project_access.expires_at
FROM project
INNER JOIN account ON project.user_id = account.id
INNER JOIN project_access ON project.id = project_access.project_id
WHERE account.pen_name = CAST(:penName AS CITEXT)
  AND project.name = CAST(:projectName AS CITEXT)
  AND project_access.access_password = :password;

hasAnyAccessForProject:
SELECT EXISTS(
    SELECT 1
    FROM project
    INNER JOIN account ON project.user_id = account.id
    INNER JOIN project_access ON project.id = project_access.project_id
    WHERE account.pen_name = CAST(:penName AS CITEXT)
      AND project.name = CAST(:projectName AS CITEXT)
) AS has_access;

getPublishedStoriesByPenName:
SELECT
    project.uuid AS project_uuid,
    project.name AS project_name,
    project_access.published_at AS published_at
FROM project
INNER JOIN account ON project.user_id = account.id
INNER JOIN project_access ON project.id = project_access.project_id
WHERE account.pen_name = CAST(:penName AS CITEXT)
  AND project_access.access_password IS NULL
  AND (project_access.expires_at IS NULL OR project_access.expires_at > NOW())
ORDER BY project.name ASC;

getCommunityFeedStories:
SELECT
    project.uuid AS project_uuid,
    project.name AS project_name,
    account.pen_name AS pen_name,
    project_access.published_at AS published_at
FROM project
INNER JOIN account ON project.user_id = account.id
INNER JOIN project_access ON project.id = project_access.project_id
WHERE account.community_member = TRUE
  AND account.pen_name IS NOT NULL
  AND project_access.access_password IS NULL
  AND (project_access.expires_at IS NULL OR project_access.expires_at > NOW())
ORDER BY project_access.published_at DESC
LIMIT :limit OFFSET :offset;

countCommunityFeedStories:
SELECT COUNT(*)
FROM project
INNER JOIN account ON project.user_id = account.id
INNER JOIN project_access ON project.id = project_access.project_id
WHERE account.community_member = TRUE
  AND account.pen_name IS NOT NULL
  AND project_access.access_password IS NULL
  AND (project_access.expires_at IS NULL OR project_access.expires_at > NOW());
