CREATE TABLE project_access (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    project_id INTEGER NOT NULL,
    access_password TEXT DEFAULT NULL,
    expires_at TEXT DEFAULT NULL,
    FOREIGN KEY(project_id) REFERENCES project(id) ON DELETE CASCADE,
    UNIQUE(project_id)
);

getAccessForProject:
SELECT *
FROM project_access
WHERE project_id = :projectId;

updateAccess:
INSERT OR REPLACE INTO project_access(project_id, access_password, expires_at)
VALUES (?, ?, ?);

deleteAccess:
DELETE FROM project_access
WHERE project_id = :projectId;

deleteAllAccessForUser:
DELETE FROM project_access
WHERE project_id IN (
    SELECT id FROM project WHERE user_id = :userId
);

findPublicProjectByPenNameAndProjectName:
SELECT
    project.uuid AS project_uuid,
    project.user_id,
    project.name AS project_name,
    account.pen_name,
    project_access.expires_at
FROM project
INNER JOIN account ON project.user_id = account.id
INNER JOIN project_access ON project.id = project_access.project_id
WHERE account.pen_name = :penName
  AND project.name = :projectName
  AND project_access.access_password IS NULL;
