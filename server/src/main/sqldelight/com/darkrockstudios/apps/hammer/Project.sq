import kotlinx.datetime.Instant;

-- uuid column is declared TEXT here for SqlDelight's parser, and promoted to
-- UUID in PostgresSchemaPostInit so it gets 16-byte storage + validation. The
-- SqlDelight Kotlin API still sees it as String.
CREATE TABLE project (
    id BIGSERIAL PRIMARY KEY,
    uuid TEXT NOT NULL,
    user_id BIGINT NOT NULL,
    name TEXT NOT NULL,
    last_id BIGINT NOT NULL DEFAULT 0,
    last_sync TIMESTAMPTZ AS Instant NOT NULL DEFAULT NOW(),
    CONSTRAINT project_name_len CHECK (length(name) BETWEEN 1 AND 200),
    FOREIGN KEY(user_id) REFERENCES account(id) ON DELETE CASCADE,
    UNIQUE(name, user_id)
);

CREATE UNIQUE INDEX project_uuid_unique ON project (uuid);
CREATE UNIQUE INDEX user_project_name_lookup ON project (user_id, name);
CREATE INDEX project_user_id_idx ON project (user_id);

getProjects:
SELECT name, uuid
FROM project
WHERE user_id = :userId;

getProjectsWithSyncDate:
SELECT name, uuid, last_sync
FROM project
WHERE user_id = :userId
ORDER BY last_sync DESC;

getProjectsWithSyncDatePaged:
SELECT name, uuid, last_sync
FROM project
WHERE user_id = :userId
ORDER BY last_sync DESC
LIMIT :limit OFFSET :offset;

getProjectsCount:
SELECT count(*)
FROM project
WHERE user_id = :userId;

getMostRecentSyncForUser:
SELECT MAX(last_sync) AS last_sync
FROM project
WHERE user_id = :userId;

insertProject:
INSERT INTO project(user_id, name, uuid, last_sync, last_id)
VALUES(:userId, :name, :uuid, :lastSync, :lastId);

createProject:
INSERT INTO project(user_id, name, uuid)
VALUES(:userId, :name, :uuid);

hasProjectById:
SELECT EXISTS(SELECT 1 FROM project WHERE user_id = :userId AND uuid = :projectId);

updateProjectName:
UPDATE project
SET name = :name
WHERE user_id = :userId AND uuid = :uuid;

updateSyncData:
UPDATE project
SET last_id = :lastId, last_sync = :lastSync
WHERE user_id = :userId AND name = :name;

findProjectByName:
SELECT *
FROM project
WHERE user_id = :userId AND name = :name;

getProject:
SELECT *
FROM project
WHERE user_id = :userId AND uuid = :uuid;

getProjectId:
SELECT id
FROM project
WHERE user_id = :userId AND uuid = :uuid;

deleteProject:
DELETE FROM project
WHERE user_id = :userId AND uuid = :uuid;
