import kotlinx.datetime.Instant;

-- uuid column is declared TEXT here for SqlDelight's parser, and promoted to
-- UUID in PostgresSchemaPostInit so it gets 16-byte storage + validation. The
-- SqlDelight Kotlin API still sees it as String.
CREATE TABLE project (
    id BIGSERIAL PRIMARY KEY,
    uuid TEXT NOT NULL,
    user_id BIGINT NOT NULL,
    name TEXT NOT NULL,
    last_id BIGINT NOT NULL DEFAULT 0,
    last_sync TIMESTAMPTZ AS Instant NOT NULL DEFAULT NOW(),
    CONSTRAINT project_name_len CHECK (length(name) BETWEEN 1 AND 200),
    FOREIGN KEY(user_id) REFERENCES account(id) ON DELETE CASCADE,
    UNIQUE(name, user_id)
);

CREATE UNIQUE INDEX project_uuid_unique ON project (uuid);
CREATE UNIQUE INDEX user_project_name_lookup ON project (user_id, name);
CREATE INDEX project_user_id_idx ON project (user_id);

getProjects:
SELECT name, uuid
FROM project
WHERE user_id = :userId;

getProjectsWithSyncDate:
SELECT name, uuid, last_sync
FROM project
WHERE user_id = :userId
ORDER BY last_sync DESC;

getProjectsWithSyncDatePaged:
SELECT name, uuid, last_sync
FROM project
WHERE user_id = :userId
ORDER BY last_sync DESC
LIMIT :limit OFFSET :offset;

getProjectsCount:
SELECT count(*)
FROM project
WHERE user_id = :userId;

getMostRecentSyncForUser:
SELECT MAX(last_sync) AS last_sync
FROM project
WHERE user_id = :userId;

-- The uuid column is promoted to UUID at runtime by PostgresSchemaInitializer.
-- Postgres won't auto-cast bound text parameters against UUID columns in
-- comparisons or against the UNIQUE index, so callers route through
-- CAST(:uuid AS UUID) everywhere they bind a String.
insertProject:
INSERT INTO project(user_id, name, uuid, last_sync, last_id)
VALUES(:userId, :name, CAST(:uuid AS UUID), :lastSync, :lastId);

createProject:
INSERT INTO project(user_id, name, uuid)
VALUES(:userId, :name, CAST(:uuid AS UUID));

hasProjectById:
SELECT EXISTS(SELECT 1 FROM project WHERE user_id = :userId AND uuid = CAST(:projectId AS UUID));

updateProjectName:
UPDATE project
SET name = :name
WHERE user_id = :userId AND uuid = CAST(:uuid AS UUID);

-- name is CITEXT post-init; bound text params need an explicit cast for the
-- comparison to use the citext-equality operator (case-insensitive).
updateSyncData:
UPDATE project
SET last_id = :lastId, last_sync = :lastSync
WHERE user_id = :userId AND name = CAST(:name AS CITEXT);

findProjectByName:
SELECT *
FROM project
WHERE user_id = :userId AND name = CAST(:name AS CITEXT);

getProject:
SELECT *
FROM project
WHERE user_id = :userId AND uuid = CAST(:uuid AS UUID);

getProjectId:
SELECT id
FROM project
WHERE user_id = :userId AND uuid = CAST(:uuid AS UUID);

deleteProject:
DELETE FROM project
WHERE user_id = :userId AND uuid = CAST(:uuid AS UUID);
