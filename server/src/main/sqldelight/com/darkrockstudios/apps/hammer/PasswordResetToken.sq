CREATE TABLE password_reset_token(
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    user_id INTEGER NOT NULL,
    token TEXT UNIQUE NOT NULL,
    created TEXT DEFAULT (datetime('now')) NOT NULL,
    expires TEXT NOT NULL,
    used INTEGER AS kotlin.Boolean DEFAULT FALSE NOT NULL,
    FOREIGN KEY(user_id) REFERENCES account(id) ON DELETE CASCADE
);

CREATE INDEX password_reset_token_lookup ON password_reset_token(token);
CREATE INDEX password_reset_token_expires ON password_reset_token(expires);

getTokenByToken:
SELECT * FROM password_reset_token WHERE token = ?;

createToken:
INSERT INTO password_reset_token(user_id, token, expires)
VALUES (?, ?, ?);

markTokenAsUsed:
UPDATE password_reset_token SET used = 1 WHERE token = ?;

deleteExpiredTokens:
DELETE FROM password_reset_token WHERE expires < datetime('now');

getRecentTokenCount:
SELECT COUNT(*) FROM password_reset_token
WHERE user_id = ?
AND created > ?;
