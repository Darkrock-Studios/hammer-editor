import kotlin.time.Instant;

CREATE TABLE password_reset_token(
    id BIGSERIAL PRIMARY KEY,
    user_id BIGINT NOT NULL,
    token TEXT NOT NULL UNIQUE,
    created TIMESTAMPTZ AS Instant NOT NULL DEFAULT NOW(),
    expires TIMESTAMPTZ AS Instant NOT NULL,
    used BOOLEAN NOT NULL DEFAULT FALSE,
    CONSTRAINT password_reset_expires_after_created CHECK (expires > created),
    FOREIGN KEY(user_id) REFERENCES account(id) ON DELETE CASCADE
);

CREATE INDEX password_reset_token_lookup ON password_reset_token (token);
CREATE INDEX password_reset_token_user_id_idx ON password_reset_token (user_id);
CREATE INDEX password_reset_token_expires_idx ON password_reset_token (expires);

getTokenByToken:
SELECT * FROM password_reset_token WHERE token = ?;

createToken:
INSERT INTO password_reset_token(user_id, token, expires)
VALUES (?, ?, ?);

markTokenAsUsed:
UPDATE password_reset_token SET used = TRUE WHERE token = ?;

deleteExpiredTokens:
DELETE FROM password_reset_token WHERE expires < NOW();

getRecentTokenCount:
SELECT COUNT(*) FROM password_reset_token
WHERE user_id = ?
AND created > ?;

deleteAllForUser:
DELETE FROM password_reset_token WHERE user_id = :userId;
