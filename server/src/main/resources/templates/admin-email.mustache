{{> header}}

<main class="page">
	<div class="admin-layout">
		{{> partials/admin-nav}}

		<div class="admin-content">
			<!-- Admin Header -->
			<div class="page-header">
				<div class="page-header__content">
					<h1 class="page-header__title">{{msg.admin_email_title}}</h1>
					<p class="page-header__subtitle">{{msg.admin_email_subtitle}}</p>
				</div>
			</div>

			<!-- Email Status Section -->
			<section class="paper-section">
				<div class="section-header">
					<h2 class="section-header__title">{{msg.admin_email_status_title}}</h2>
				</div>

				<div class="status-info">
					<div class="status-item">
						<span class="status-label">{{msg.admin_email_status_label}}:</span>
						{{#emailConfigured}}
							<span class="status-badge status-badge--active">{{msg.admin_email_configured}}</span>
						{{/emailConfigured}}
						{{^emailConfigured}}
							<span class="status-badge status-badge--inactive">{{msg.admin_email_not_configured}}</span>
						{{/emailConfigured}}
					</div>
				</div>

				<!-- Success/Error Display -->
				<div id="email-success"></div>
				<div id="email-error"></div>
			</section>

			<!-- SMTP Settings Section -->
			<section class="paper-section">
				<div class="section-header">
					<h2 class="section-header__title">{{msg.admin_email_settings_title}}</h2>
				</div>
				<p class="section-description">{{msg.admin_email_settings_description}}</p>

				<form action="/admin/email/settings" method="post" class="settings-form"
					  hx-post="/admin/email/settings"
					  hx-swap="none">

					<div class="form-group">
						<label for="host" class="form-field__label">{{msg.admin_email_host}}</label>
						<p class="form-field__help">{{msg.admin_email_host_help}}</p>
						<div class="form-input-group">
							<input id="host" name="host" type="text" value="{{smtpHost}}"
								   class="form-input"
								   placeholder="{{msg.admin_email_host_placeholder}}"/>
						</div>
					</div>

					<div class="form-group">
						<label for="port" class="form-field__label">{{msg.admin_email_port}}</label>
						<p class="form-field__help">{{msg.admin_email_port_help}}</p>
						<div class="form-input-group">
							<input id="port" name="port" type="number" min="1" max="65535"
								   value="{{smtpPort}}" class="form-input"
								   placeholder="{{msg.admin_email_port_placeholder}}"/>
						</div>
					</div>

					<div class="form-group">
						<label for="username" class="form-field__label">{{msg.admin_email_username}}</label>
						<p class="form-field__help">{{msg.admin_email_username_help}}</p>
						<div class="form-input-group">
							<input id="username" name="username" type="text" value="{{smtpUsername}}"
								   class="form-input"
								   placeholder="{{msg.admin_email_username_placeholder}}"/>
						</div>
					</div>

					<div class="form-group">
						<label for="password" class="form-field__label">{{msg.admin_email_password}}</label>
						<p class="form-field__help">{{msg.admin_email_password_help}}</p>
						<div class="form-input-group">
							<input id="password" name="password" type="password"
								   class="form-input"
								   placeholder="{{msg.admin_email_password_placeholder}}"/>
						</div>
					</div>

					<div class="form-group">
						<label for="fromAddress" class="form-field__label">{{msg.admin_email_from_address}}</label>
						<p class="form-field__help">{{msg.admin_email_from_address_help}}</p>
						<div class="form-input-group">
							<input id="fromAddress" name="fromAddress" type="email" value="{{smtpFromAddress}}"
								   class="form-input"
								   placeholder="{{msg.admin_email_from_address_placeholder}}"/>
						</div>
					</div>

					<div class="form-group">
						<label for="fromName" class="form-field__label">{{msg.admin_email_from_name}}</label>
						<p class="form-field__help">{{msg.admin_email_from_name_help}}</p>
						<div class="form-input-group">
							<input id="fromName" name="fromName" type="text" value="{{smtpFromName}}"
								   class="form-input"
								   placeholder="{{msg.admin_email_default_from_name}}"/>
						</div>
					</div>

					<div class="form-group">
						<label class="form-field__label">
							<input type="checkbox" name="useTls" value="true"
								   {{#smtpUseTls}}checked{{/smtpUseTls}} class="form-checkbox"/>
							{{msg.admin_email_use_tls}}
						</label>
						<p class="form-field__help">{{msg.admin_email_use_tls_help}}</p>
					</div>

					<div class="form-group">
						<label class="form-field__label">
							<input type="checkbox" name="useStartTls" value="true"
								   {{#smtpUseStartTls}}checked{{/smtpUseStartTls}} class="form-checkbox"/>
							{{msg.admin_email_use_starttls}}
						</label>
						<p class="form-field__help">{{msg.admin_email_use_starttls_help}}</p>
					</div>

					<div class="form-actions">
						<button type="submit" class="btn btn--accent">{{msg.admin_email_save_button}}</button>
					</div>
				</form>
			</section>

			<!-- Test Email Section -->
			<section class="paper-section">
				<div class="section-header">
					<h2 class="section-header__title">{{msg.admin_email_test_title}}</h2>
				</div>
				<p class="section-description">{{msg.admin_email_test_description}}</p>

				<form class="settings-form"
					  hx-post="/admin/email/test"
					  hx-target="#email-result"
					  hx-swap="innerHTML"
					  hx-on::before-request="document.getElementById('email-result').innerHTML = '';">

					<div class="form-group">
						<label for="testRecipient" class="form-field__label">{{msg.admin_email_test_recipient}}</label>
						<p class="form-field__help">{{msg.admin_email_test_recipient_help}}</p>
						<div class="form-input-group">
							<input id="testRecipient" name="testRecipient" type="email"
								   class="form-input"
								   placeholder="{{msg.admin_email_test_recipient_placeholder}}"/>
							<button type="submit" class="btn btn--primary" hx-indicator="#email-sending-indicator">
								<span class="button-text">{{msg.admin_email_test_send}}</span>
								<span id="email-sending-indicator" class="htmx-indicator">
									<span class="spinner"></span> Sending...
								</span>
							</button>
						</div>
					</div>

					<!-- Result container -->
					<div id="email-result"></div>
				</form>
			</section>
		</div>
	</div>
</main>

<div id="result"></div>
{{> footer}}
