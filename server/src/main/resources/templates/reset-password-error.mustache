{{> header}}

<main class="page page--centered">
	<div class="page__container page__container--narrow">
		<div class="paper-section paper-section--compact">
			<div class="login-header">
				<h1>{{msg.password_reset_error_title}}</h1>
			</div>

			<div class="password-reset-error">
				<div class="password-reset-error__icon">⚠️</div>
				<p class="password-reset-error__message">{{error}}</p>
			</div>

			<div class="form-actions">
				<a href="/forgot-password" class="login-button">{{msg.password_reset_request_new}}</a>
			</div>

			<div class="login-info">
				<p class="login-info-text">
					<a href="/login">{{msg.password_reset_back_to_login}}</a>
				</p>
			</div>
		</div>
	</div>
</main>

{{> footer}}
