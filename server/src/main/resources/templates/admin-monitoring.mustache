{{> header}}

<link rel="stylesheet" href="/assets/css/monitoring.css">

<main class="page">
	<div class="admin-layout">
		{{> partials/admin-nav}}

		<div class="admin-content">
			<div class="page-header">
				<div class="page-header__content">
					<h1 class="page-header__title">{{msg.admin_mon_overview_title}}</h1>
					<p class="page-header__subtitle">{{msg.admin_mon_overview_subtitle}}</p>
				</div>
			</div>

			{{> partials/monitoring-nav}}

			{{^monitoringEnabled}}
				<div class="mon-notice">
					<i class="fa-solid fa-circle-info"></i>
					<span>{{msg.admin_mon_disabled_notice}}</span>
				</div>
			{{/monitoringEnabled}}

			<!-- Alerts: the "something needs me" signal -->
			<section class="paper-section">
				<div class="section-header">
					<h2 class="section-header__title">{{msg.admin_mon_alerts_title}}</h2>
				</div>
				{{#hasAlerts}}
					<div class="mon-alert-list">
						{{#alerts}}
							<div class="mon-alert mon-alert--{{severity}}">
								<i class="fa-solid fa-triangle-exclamation mon-alert__icon"></i>
								<div class="mon-alert__body">
									<span class="mon-alert__route">{{route}}</span>
									<span class="mon-alert__detail">{{detail}}</span>
								</div>
								<a class="mon-alert__action" href="{{href}}">
									{{msg.admin_mon_alerts_investigate}} <i class="fa-solid fa-chevron-right"></i>
								</a>
							</div>
						{{/alerts}}
					</div>
				{{/hasAlerts}}
				{{^hasAlerts}}
					<div class="mon-nominal">
						<i class="fa-solid fa-circle-check"></i>
						<span>{{msg.admin_mon_alerts_nominal}}</span>
					</div>
				{{/hasAlerts}}
			</section>

			<!-- Key stats (last 24h) -->
			<div class="mon-stat-grid">
				<div class="mon-stat-card">
					<span class="mon-stat-card__label">{{msg.admin_mon_stat_requests}}</span>
					<span class="mon-stat-card__value">{{statRequests}}</span>
					<span class="mon-stat-card__note">{{msg.admin_mon_window_24h}}</span>
				</div>
				<div class="mon-stat-card">
					<span class="mon-stat-card__label">{{msg.admin_mon_stat_error_rate}}</span>
					<span class="mon-stat-card__value">{{statErrorRate}}</span>
					<span class="mon-stat-card__note">{{msg.admin_mon_window_24h}}</span>
				</div>
				<div class="mon-stat-card">
					<span class="mon-stat-card__label">{{msg.admin_mon_stat_p95}}</span>
					<span class="mon-stat-card__value">{{statP95}}</span>
					<span class="mon-stat-card__note">{{msg.admin_mon_window_24h}}</span>
				</div>
				<div class="mon-stat-card mon-stat-card--live">
					<span class="mon-stat-card__label">{{msg.admin_mon_stat_active_syncs}}</span>
					<span class="mon-stat-card__value">{{statActiveSyncs}}</span>
					<span class="mon-stat-card__note"><i class="fa-solid fa-circle mon-live-dot"></i> {{msg.admin_mon_live}}</span>
				</div>
			</div>

			<!-- Active users: window rollups (DAU/WAU/MAU) + daily trend -->
			<section class="paper-section">
				<div class="section-header">
					<h2 class="section-header__title">{{msg.admin_mon_active_users_title}}</h2>
				</div>
                {{#hasActiveUsers}}
					<div class="mon-au-grid">
						<article class="mon-au-card">
							<header
								class="mon-au-card__window">{{msg.admin_mon_window_24h}}</header>
							<div class="mon-au-card__stats">
								<div class="mon-au-stat mon-au-stat--sync">
									<span class="mon-au-stat__value">{{usersSync24h}}</span>
									<span class="mon-au-stat__name"><i
										class="fa-solid fa-rotate"></i> {{msg.admin_mon_active_users_sync}}</span>
								</div>
								<div class="mon-au-stat mon-au-stat--web">
									<span class="mon-au-stat__value">{{usersWeb24h}}</span>
									<span class="mon-au-stat__name"><i
										class="fa-solid fa-globe"></i> {{msg.admin_mon_active_users_web}}</span>
								</div>
							</div>
						</article>
						<article class="mon-au-card">
							<header class="mon-au-card__window">{{msg.admin_mon_window_7d}}</header>
							<div class="mon-au-card__stats">
								<div class="mon-au-stat mon-au-stat--sync">
									<span class="mon-au-stat__value">{{usersSync7d}}</span>
									<span class="mon-au-stat__name"><i
										class="fa-solid fa-rotate"></i> {{msg.admin_mon_active_users_sync}}</span>
								</div>
								<div class="mon-au-stat mon-au-stat--web">
									<span class="mon-au-stat__value">{{usersWeb7d}}</span>
									<span class="mon-au-stat__name"><i
										class="fa-solid fa-globe"></i> {{msg.admin_mon_active_users_web}}</span>
								</div>
							</div>
						</article>
						<article class="mon-au-card">
							<header
								class="mon-au-card__window">{{msg.admin_mon_window_30d}}</header>
							<div class="mon-au-card__stats">
								<div class="mon-au-stat mon-au-stat--sync">
									<span class="mon-au-stat__value">{{usersSync30d}}</span>
									<span class="mon-au-stat__name"><i
										class="fa-solid fa-rotate"></i> {{msg.admin_mon_active_users_sync}}</span>
								</div>
								<div class="mon-au-stat mon-au-stat--web">
									<span class="mon-au-stat__value">{{usersWeb30d}}</span>
									<span class="mon-au-stat__name"><i
										class="fa-solid fa-globe"></i> {{msg.admin_mon_active_users_web}}</span>
								</div>
							</div>
						</article>
					</div>
					<h3 class="mon-users-trend-title">{{msg.admin_mon_active_users_trend}}</h3>
					<div class="mon-chart" id="mon-active-users-chart"></div>
				{{/hasActiveUsers}}
				{{^hasActiveUsers}}
					<div class="empty-state">
						<div class="empty-state__icon">📈</div>
						<p>{{msg.admin_mon_no_data}}</p>
					</div>
				{{/hasActiveUsers}}
			</section>

			<!-- Story readers: best-effort unique readers of published / shared stories -->
			<section class="paper-section">
				<div class="section-header">
					<h2 class="section-header__title">{{msg.admin_mon_readers_title}}</h2>
				</div>
				<p class="section-description">{{msg.admin_mon_readers_subtitle}}</p>
				{{#hasReaders}}
					<div class="mon-au-grid">
						<article class="mon-au-card">
							<header
								class="mon-au-card__window">{{msg.admin_mon_window_24h}}</header>
							<div class="mon-au-card__stats mon-au-card__stats--single">
								<div class="mon-au-stat mon-au-stat--readers">
									<span class="mon-au-stat__value">{{readers24h}}</span>
									<span class="mon-au-stat__name"><i
										class="fa-solid fa-book-open"></i> {{msg.admin_mon_readers_unique}}</span>
								</div>
							</div>
						</article>
						<article class="mon-au-card">
							<header class="mon-au-card__window">{{msg.admin_mon_window_7d}}</header>
							<div class="mon-au-card__stats mon-au-card__stats--single">
								<div class="mon-au-stat mon-au-stat--readers">
									<span class="mon-au-stat__value">{{readers7d}}</span>
									<span class="mon-au-stat__name"><i
										class="fa-solid fa-book-open"></i> {{msg.admin_mon_readers_unique}}</span>
								</div>
							</div>
						</article>
						<article class="mon-au-card">
							<header
								class="mon-au-card__window">{{msg.admin_mon_window_30d}}</header>
							<div class="mon-au-card__stats mon-au-card__stats--single">
								<div class="mon-au-stat mon-au-stat--readers">
									<span class="mon-au-stat__value">{{readers30d}}</span>
									<span class="mon-au-stat__name"><i
										class="fa-solid fa-book-open"></i> {{msg.admin_mon_readers_unique}}</span>
								</div>
							</div>
						</article>
					</div>
					<h3 class="mon-users-trend-title">{{msg.admin_mon_readers_trend}}</h3>
					<div class="mon-chart" id="mon-readers-chart"></div>
				{{/hasReaders}}
				{{^hasReaders}}
					<div class="empty-state">
						<div class="empty-state__icon">📖</div>
						<p>{{msg.admin_mon_no_data}}</p>
					</div>
				{{/hasReaders}}
			</section>

			<!-- Traffic chart -->
			<section class="paper-section">
				<div class="section-header">
					<h2 class="section-header__title">{{msg.admin_mon_traffic_title}}</h2>
				</div>
				<div class="mon-chart" id="mon-requests-chart"></div>
			</section>

			<!-- Slowest endpoints -->
			<section class="paper-section">
				<div class="section-header">
					<h2 class="section-header__title">{{msg.admin_mon_slowest_title}}</h2>
					<div class="section-header__actions">
						<a class="btn btn--ghost" href="/admin/monitoring/performance">{{msg.admin_mon_view_all}}</a>
					</div>
				</div>
				{{#hasTopSlow}}
					<div class="mon-rank-list">
						{{#topSlow}}
							<div class="mon-rank">
								<span class="mon-rank__method mon-method--{{method}}">{{method}}</span>
								<span class="mon-rank__route">{{route}}</span>
								<span class="mon-rank__p95">{{p95}}</span>
							</div>
						{{/topSlow}}
					</div>
				{{/hasTopSlow}}
				{{^hasTopSlow}}
					<div class="empty-state"><p>{{msg.admin_mon_no_data}}</p></div>
				{{/hasTopSlow}}
			</section>
		</div>
	</div>
</main>

<script src="/assets/js/frappe-charts.min.js"></script>
<script>
	(function () {
		var data = {{{chartJson}}};
		var el = document.getElementById("mon-requests-chart");
		if (!el || !data.labels || !data.labels.length) {
			if (el) el.innerHTML = '<p class="mon-chart__empty">{{msg.admin_mon_no_data}}</p>';
			return;
		}
		var ChartCtor = (window.frappe && window.frappe.Chart) || window.Chart;
		if (!ChartCtor) return;
		new ChartCtor(el, {
			data: {
				labels: data.labels,
				datasets: [
					{ name: "{{msg.admin_mon_stat_requests}}", values: data.requests },
					{ name: "{{msg.admin_mon_errors}}", values: data.errors }
				]
			},
			type: "line",
			height: 240,
			colors: ["#d97706", "#ef4444"],
			axisOptions: { xAxisMode: "tick", xIsSeries: true },
			lineOptions: { hideDots: 0, regionFill: 0 }
		});
	})();

	(function () {
		var el = document.getElementById("mon-active-users-chart");
		if (!el) return;
		var data = {{{activeUsersChartJson}}};
		if (!data.labels || !data.labels.length) return;
		var ChartCtor = (window.frappe && window.frappe.Chart) || window.Chart;
		if (!ChartCtor) return;
		new ChartCtor(el, {
			data: {
				labels: data.labels,
				datasets: [
					{ name: "{{msg.admin_mon_active_users_sync}}", values: data.sync },
					{ name: "{{msg.admin_mon_active_users_web}}", values: data.web }
				]
			},
			type: "line",
			height: 240,
			colors: ["#d97706", "#2563eb"],
			axisOptions: { xAxisMode: "tick", xIsSeries: true },
			lineOptions: { hideDots: 0, regionFill: 0 }
		});
	})();

	(function () {
		var el = document.getElementById("mon-readers-chart");
		if (!el) return;
		var data = {{{readersChartJson}}};
		if (!data.labels || !data.labels.length) return;
		var ChartCtor = (window.frappe && window.frappe.Chart) || window.Chart;
		if (!ChartCtor) return;
		new ChartCtor(el, {
			data: {
				labels: data.labels,
				datasets: [
					{ name: "{{msg.admin_mon_readers_unique}}", values: data.readers }
				]
			},
			type: "line",
			height: 240,
			colors: ["#d97706"],
			axisOptions: { xAxisMode: "tick", xIsSeries: true },
			lineOptions: { hideDots: 0, regionFill: 0 }
		});
	})();
</script>

{{> footer}}
