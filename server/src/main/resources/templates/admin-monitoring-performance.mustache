{{> header}}

<link rel="stylesheet" href="/assets/css/monitoring.css?v={{version}}">

<main class="page">
	<div class="admin-layout">
		{{> partials/admin-nav}}

		<div class="admin-content">
			<div class="page-header">
				<div class="page-header__content">
					<h1 class="page-header__title">{{msg.admin_mon_perf_title}}</h1>
					<p class="page-header__subtitle">{{msg.admin_mon_perf_subtitle}}</p>
				</div>
			</div>

			{{> partials/monitoring-nav}}

			<section class="paper-section">
				<div class="section-header">
					<h2 class="section-header__title">{{msg.admin_mon_perf_latency_title}}</h2>
					<div class="section-header__actions mon-range">
						<a class="mon-range__btn {{#range24h}}mon-range__btn--active{{/range24h}}"
						   href="/admin/monitoring/performance?range=24h">{{msg.admin_mon_range_24h}}</a>
						<a class="mon-range__btn {{#range7d}}mon-range__btn--active{{/range7d}}"
						   href="/admin/monitoring/performance?range=7d">{{msg.admin_mon_range_7d}}</a>
						<a class="mon-range__btn {{#range30d}}mon-range__btn--active{{/range30d}}"
						   href="/admin/monitoring/performance?range=30d">{{msg.admin_mon_range_30d}}</a>
					</div>
				</div>
				<div class="mon-chart" id="mon-latency-chart"></div>
			</section>

			<section class="paper-section">
				<div class="section-header">
					<h2 class="section-header__title">{{msg.admin_mon_perf_endpoints}}</h2>
				</div>

				{{#hasEndpoints}}
					<div class="mon-table-wrap">
						<table class="mon-table" id="endpointsTable">
							<thead>
							<tr>
								<th data-col="0" data-type="str">{{msg.admin_mon_col_endpoint}}<span class="mon-sort-ind"></span></th>
								<th class="mon-table__num" data-col="1" data-type="num">{{msg.admin_mon_col_requests}}<span class="mon-sort-ind"></span></th>
								<th class="mon-table__num" data-col="2" data-type="num">{{msg.admin_mon_col_errors}}<span class="mon-sort-ind"></span></th>
								<th class="mon-table__num" data-col="3" data-type="num">{{msg.admin_mon_col_p50}}<span class="mon-sort-ind"></span></th>
								<th class="mon-table__num" data-col="4" data-type="num">{{msg.admin_mon_col_p95}}<span class="mon-sort-ind"></span></th>
								<th class="mon-table__num" data-col="5" data-type="num">{{msg.admin_mon_col_p99}}<span class="mon-sort-ind"></span></th>
							</tr>
							</thead>
							<tbody>
							{{#endpoints}}
								<tr>
									<td class="mon-table__endpoint" data-val="{{method}} {{route}}">
										<span class="mon-rank__method mon-method--{{method}}">{{method}}</span>
										<span class="mon-table__route">{{route}}</span>
									</td>
									<td class="mon-table__num" data-val="{{requestCountRaw}}">{{requestCount}}</td>
									<td class="mon-table__num {{#hasErrors}}mon-table__num--err{{/hasErrors}}" data-val="{{errorRateRaw}}">{{errorRate}}</td>
									<td class="mon-table__num" data-val="{{p50Raw}}">{{p50}}</td>
									<td class="mon-table__num" data-val="{{p95Raw}}">{{p95}}</td>
									<td class="mon-table__num" data-val="{{p99Raw}}">{{p99}}</td>
								</tr>
							{{/endpoints}}
							</tbody>
						</table>
					</div>
				{{/hasEndpoints}}
				{{^hasEndpoints}}
					<div class="empty-state"><p>{{msg.admin_mon_no_data}}</p></div>
				{{/hasEndpoints}}
			</section>
		</div>
	</div>
</main>

<script src="/assets/js/frappe-charts.min.js?v={{version}}"></script>
<script type="application/json" id="mon-labels">{{{monitoringLabels}}}</script>
<script type="application/json" id="mon-latency-data">{{{latencyChartJson}}}</script>

<script defer src="/assets/js/admin-monitoring.js?v={{version}}"></script>

{{> footer}}
