{{> header}}

<main class="password-form-page">
	<div class="password-form-container">
		<div class="password-form-icon">
			<i class="fas fa-lock"></i>
		</div>
		<h2>{{msg.public_story_password_required}}</h2>
		<p class="password-form-description">{{msg.public_story_password_description}}</p>

		<form hx-post="/a/{{penName}}/{{projectName}}"
			  hx-target="body"
			  hx-swap="innerHTML"
			  class="password-form">
			<div class="form-field">
				<label for="password" class="form-field__label">{{msg.public_story_password_label}}</label>
				<input type="password"
					   id="password"
					   name="password"
					   class="form-input"
					   required
					   autofocus
					   placeholder="{{msg.public_story_password_placeholder}}">
			</div>

			{{#error}}
			<div class="password-error">
				<i class="fas fa-exclamation-circle"></i>
				{{msg.public_story_password_incorrect}}
			</div>
			{{/error}}

			<button type="submit" class="password-submit-btn">
				{{msg.public_story_password_submit}}
			</button>
		</form>
	</div>
</main>

{{> footer}}
