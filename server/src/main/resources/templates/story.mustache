{{> header}}

<main class="story-page">
	<div class="story-container">
		<a href="/dashboard" class="back-link">
			<i class="fas fa-arrow-left" aria-hidden="true"></i> {{msg.story_back_to_dashboard}}
		</a>

		<!-- Story Header -->
		<header class="story-hero{{#coverImageUrl}} story-hero--cover{{/coverImageUrl}}">
			{{#coverImageUrl}}
				<img class="story-cover" src="{{coverImageUrl}}" alt="">
			{{/coverImageUrl}}
			<div class="story-hero__body">
				<h1 class="story-title">{{projectName}}</h1>
				{{#hasChapters}}
					<div class="story-hero__actions" id="story-read-actions" data-project-key="{{projectKey}}"
						 data-chapter-count="{{chapterCount}}"{{#coverImageUrl}} data-has-cover="true"{{/coverImageUrl}}>
						<a href="{{readUrl}}" class="btn btn--accent story-hero__read">
							<i class="fas fa-book-open" aria-hidden="true"></i> {{msg.story_read_button}}
						</a>
						<a href="{{readUrl}}" class="story-hero__continue" data-read-url="{{readUrl}}"
						   data-continue-label="{{msg.story_read_continue}}" hidden></a>
					</div>
				{{/hasChapters}}
			</div>
		</header>

		<!-- Headline numbers -->
		<dl class="story-stats-strip">
			<div class="story-stat">
				<dt class="story-stat__label">{{msg.story_info_words}}</dt>
				<dd class="story-stat__value">{{wordCount}}</dd>
			</div>
			<div class="story-stat">
				<dt class="story-stat__label">{{msg.story_info_chapters}}</dt>
				<dd class="story-stat__value">{{chapterCount}}</dd>
			</div>
			<div class="story-stat">
				<dt class="story-stat__label">{{msg.story_info_scenes}}</dt>
				<dd class="story-stat__value">{{sceneCount}}</dd>
			</div>
			{{#hasWords}}
				<div class="story-stat">
					<dt class="story-stat__label">{{msg.story_info_reading_time}}</dt>
					<dd class="story-stat__value">{{readingTime}}</dd>
				</div>
			{{/hasWords}}
			<div class="story-stat story-stat--sync">
				<dt class="story-stat__label">{{msg.story_info_last_sync}}</dt>
				<dd class="story-stat__value">{{lastSync}}</dd>
			</div>
		</dl>

		{{^complete}}
			<p class="reader-notice" role="status">
				<i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
				{{msg.story_read_incomplete}}
			</p>
		{{/complete}}

		{{^hasChapters}}
			<div class="story-empty story-empty--panel">
				<p>{{msg.story_no_scenes}}</p>
			</div>
		{{/hasChapters}}

		<!-- Panels -->
		<div class="story-panels">
			<div class="story-panels__column">
				{{#hasPenName}}
					<section class="story-info-panel story-info-panel--sharing">
						<div class="info-panel-header">
							<span class="info-panel-icon"><i class="fas fa-share-nodes" aria-hidden="true"></i></span>
							<h2 class="info-panel-title">{{msg.story_settings_title}}</h2>
						</div>
						<div class="info-panel-content">
							{{> partials/story-publish}}
						</div>
					</section>
				{{/hasPenName}}

				<!-- Editorial Reviews Panel -->
				<section class="story-info-panel review-panel">
					<div class="info-panel-header">
						<span class="info-panel-icon info-panel-icon--review"><i class="fas fa-pen-nib" aria-hidden="true"></i></span>
						<h2 class="info-panel-title">{{msg.review_panel_title}}</h2>
					</div>
					{{> partials/review-panel}}
				</section>
			</div>

			<div class="story-panels__column">
				{{#hasAnyAccess}}
					<!-- Readers Panel: all-time total + 30-day trend -->
					<section class="story-info-panel story-info-panel--readers">
						<div class="info-panel-header">
							<span class="info-panel-icon"><i class="fas fa-book-open-reader" aria-hidden="true"></i></span>
							<h2 class="info-panel-title">{{msg.story_readers_title}}</h2>
						</div>
						<div class="info-panel-content">
							<div class="reader-total">
								<span class="reader-total__value">{{totalReaders}}</span>
								<span class="reader-total__label">{{msg.story_readers_total_label}}</span>
							</div>
							{{#hasReaderBars}}
								<div class="reader-graph" role="img" aria-label="{{msg.story_readers_graph_caption}}">
									{{#readerBars}}
										<span class="reader-graph__bar" style="height: {{height}}%" data-label="{{label}}"></span>
									{{/readerBars}}
								</div>
								<span class="reader-graph__caption">{{msg.story_readers_graph_caption}}</span>
							{{/hasReaderBars}}
						</div>
					</section>
				{{/hasAnyAccess}}

				{{> partials/story-kudos-panel}}
			</div>
		</div>
	</div>
</main>

<!-- Outside the panels: a positioned ancestor makes a stacking context the
     overlay's z-index can't escape, which paints it under the site header. -->
<div id="review-dialog-container"></div>
<div id="share-dialog-container"></div>
<div id="publish-warning-container"></div>

{{> footer}}
