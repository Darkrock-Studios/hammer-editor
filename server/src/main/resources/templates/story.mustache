{{> header}}

<main class="story-page">
	<div class="story-container">
		<!-- Story Header -->
		<div class="story-header">
			<a href="/dashboard" class="back-link">
				<i class="fas fa-arrow-left"></i> {{msg.story_back_to_dashboard}}
			</a>
			<h1 class="story-title">{{projectName}}</h1>
		</div>

		<!-- Main Layout: Story + Sidebar -->
		<div class="story-layout">
			<!-- Story Content Area -->
			<div class="story-main">
				{{#hasScenes}}
					<!-- Scene Selector -->
					<div class="scene-selector">
						<label class="scene-selector__label" for="scene-select">
							<i class="fas fa-book-open"></i>
							{{msg.story_scene_selector_label}}
						</label>
						<select class="scene-selector__dropdown form-select"
								id="scene-select"
								name="sceneId"
								hx-get="/story/{{projectNameForUrl}}/scene"
								hx-target="#story-content-area"
								hx-swap="innerHTML"
								hx-indicator="#scene-loading">
							<option value="all">{{msg.story_view_all}}</option>
							{{#sceneHierarchy}}
								<option value="{{id}}"
										{{#isGroup}}class="scene-option--group"{{/isGroup}} {{#isSelected}}selected{{/isSelected}}>{{indent}}{{name}}</option>
							{{/sceneHierarchy}}
						</select>
						<span class="scene-loading htmx-indicator" id="scene-loading">
							<i class="fas fa-spinner fa-spin"></i>
						</span>
					</div>
				{{/hasScenes}}

				<!-- Story Content -->
				<article class="story-content"{{#storyLanguage}} lang="{{storyLanguage}}"{{/storyLanguage}}
						 id="story-content-area">
					{{#hasContent}}
						{{{storyHtml}}}
					{{/hasContent}}
					{{^hasContent}}
						<div class="story-empty">
							<p>{{msg.story_no_scenes}}</p>
						</div>
					{{/hasContent}}
				</article>
			</div>

			<!-- Settings Sidebar -->
			<aside class="story-sidebar">
				<!-- Info Panel -->
				<div class="story-info-panel">
					<div class="info-panel-header">
						<span class="info-panel-icon"><i class="fas fa-info-circle"></i></span>
						<span class="info-panel-title">{{msg.story_info_title}}</span>
					</div>
					<div class="info-panel-content">
						<div class="info-item">
							<span class="info-label">{{msg.story_info_scenes}}:</span>
							<span class="info-value">{{sceneCount}}</span>
						</div>
						<div class="info-item">
							<span class="info-label">{{msg.story_info_words}}:</span>
							<span class="info-value">{{formattedWordCount}}</span>
						</div>
						<div class="info-item">
							<span class="info-label">{{msg.story_info_last_sync}}:</span>
							<span class="info-value">{{lastSync}}</span>
						</div>
					</div>
				</div>

				{{#hasPenName}}
					<!-- Sharing Panel -->
					<div class="story-settings-panel" id="story-settings-panel">
						<button class="settings-toggle-btn" id="settings-toggle-btn" type="button" aria-expanded="false"
								aria-controls="settings-content">
							<span class="settings-toggle-icon"><i class="fas fa-cog"></i></span>
							<span class="settings-toggle-text">{{msg.story_settings_title}}</span>
							<span class="settings-chevron"><i class="fas fa-chevron-down"></i></span>
						</button>

						<div class="settings-content" id="settings-content" aria-hidden="true">
							{{> partials/story-publish}}
						</div>
					</div>
				{{/hasPenName}}

				{{#hasAnyAccess}}
					<!-- Readers Panel: all-time total + 30-day trend -->
					<div class="story-info-panel story-info-panel--readers">
						<div class="info-panel-header">
							<span class="info-panel-icon"><i class="fas fa-book-open-reader"></i></span>
							<span class="info-panel-title">{{msg.story_readers_title}}</span>
						</div>
						<div class="info-panel-content">
							<div class="reader-total">
								<span class="reader-total__value">{{totalReaders}}</span>
								<span class="reader-total__label">{{msg.story_readers_total_label}}</span>
							</div>
							{{#hasReaderBars}}
								<div class="reader-graph" role="img" aria-label="{{msg.story_readers_graph_caption}}">
									{{#readerBars}}
										<span class="reader-graph__bar" style="height: {{height}}%" data-label="{{label}}"></span>
									{{/readerBars}}
								</div>
								<span class="reader-graph__caption">{{msg.story_readers_graph_caption}}</span>
							{{/hasReaderBars}}
						</div>
					</div>
				{{/hasAnyAccess}}

				<!-- Editorial Reviews Panel -->
				<div class="story-info-panel review-panel">
					<div class="info-panel-header">
						<span class="info-panel-icon info-panel-icon--review"><i class="fas fa-pen-nib"></i></span>
						<span class="info-panel-title">{{msg.review_panel_title}}</span>
					</div>
					{{> partials/review-panel}}
				</div>
				<div id="review-dialog-container"></div>
			</aside>
		</div>
	</div>
</main>

{{> footer}}
