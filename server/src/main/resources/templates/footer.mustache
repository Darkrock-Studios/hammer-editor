<footer class="site-footer">
	<div class="footer-content">
		{{#hasFooterNav}}
			<nav class="footer-nav">
				{{#hasAboutPage}}
					<a href="/about">
						<i class="fa-solid fa-info-circle"></i>
						<span>{{msg.footer_about}}</span>
					</a>
				{{/hasAboutPage}}
				{{#hasTermsPage}}
					<a href="/terms">
						<i class="fa-solid fa-file-contract"></i>
						<span>{{msg.footer_terms}}</span>
					</a>
				{{/hasTermsPage}}
				{{#hasPrivacyPage}}
					<a href="/privacy">
						<i class="fa-solid fa-user-shield"></i>
						<span>{{msg.footer_privacy}}</span>
					</a>
				{{/hasPrivacyPage}}
				{{#footerExtraLinks}}
					<a href="{{url}}"{{#external}} target="_blank" rel="noopener noreferrer"{{/external}}>
						<i class="{{icon}}"></i>
						<span>{{title}}</span>
					</a>
				{{/footerExtraLinks}}
			</nav>
		{{/hasFooterNav}}
		<div class="footer-social">
			<a href="https://github.com/Darkrock-Studios/hammer-editor" target="_blank" rel="noopener noreferrer" aria-label="{{msg.home_footer_github}}">
				<i class="fa-brands fa-github"></i>
			</a>
			<a href="https://discord.gg/4ae6y4V4F5" target="_blank" rel="noopener noreferrer" aria-label="{{msg.home_footer_discord}}">
				<i class="fa-brands fa-discord"></i>
			</a>
			<a href="https://www.reddit.com/r/HammerEditor/" target="_blank" rel="noopener noreferrer" aria-label="{{msg.home_footer_reddit}}">
				<i class="fa-brands fa-reddit"></i>
			</a>
			<a href="https://www.youtube.com/@darkrockstudios/" target="_blank" rel="noopener noreferrer" aria-label="{{msg.home_footer_youtube}}">
				<i class="fa-brands fa-youtube"></i>
			</a>
			<a href="https://mastodon.social/@DarkRockStudios" target="_blank" rel="noopener noreferrer" aria-label="{{msg.home_footer_mastodon}}">
				<i class="fa-brands fa-mastodon"></i>
			</a>
			<a href="https://bsky.app/profile/darkrockstudios.bsky.social" target="_blank" rel="noopener noreferrer" aria-label="{{msg.home_footer_bluesky}}">
				<i class="fa-brands fa-bluesky"></i>
			</a>
			{{#patreonUrl}}
				<a href="{{patreonUrl}}" target="_blank" rel="noopener noreferrer" aria-label="{{msg.home_footer_patreon}}">
					<i class="fa-brands fa-patreon"></i>
				</a>
			{{/patreonUrl}}
		</div>
		<form action="/locale" method="post" class="language-selector">
			<label for="lang-select">Language:</label>
			<select id="lang-select" name="locale" hx-post="/locale" hx-trigger="change" hx-swap="none">
				{{#locales}}
					<option value="{{tag}}" {{#selected}}selected{{/selected}}>{{label}}</option>
				{{/locales}}
			</select>
			<noscript>
				<button type="submit">Change</button>
			</noscript>
		</form>
		{{#version}}
			<div class="footer-version">v{{version}}</div>
		{{/version}}
	</div>
</footer>

<!-- Toast Container for OOB swaps -->
<div id="toast-container" aria-live="polite" aria-atomic="false"></div>

<script src="/assets/js/toast.js?v={{version}}"></script>
{{#page_pre_script}}
	<script src="{{page_pre_script}}?v={{version}}"></script>
{{/page_pre_script}}
{{#page_script}}
	<script src="{{page_script}}?v={{version}}"></script>
{{/page_script}}
</body>
</html>
