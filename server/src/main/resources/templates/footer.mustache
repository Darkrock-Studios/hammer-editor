<footer class="site-footer">
	<div class="footer-content">
		<div class="footer-links">
			{{#hasAboutPage}}
				<a href="/about">
					<i class="fa-solid fa-info-circle"></i>
					<span>{{msg.footer_about}}</span>
				</a>
			{{/hasAboutPage}}
			<a href="https://github.com/Wavesonics/hammer-editor" target="_blank">
				<i class="fa-brands fa-github"></i>
				<span>{{msg.home_footer_github}}</span>
			</a>
			<a href="https://discord.gg/4ae6y4V4F5" target="_blank">
				<i class="fa-brands fa-discord"></i>
				<span>{{msg.home_footer_discord}}</span>
			</a>
			<a href="https://www.reddit.com/r/HammerEditor/" target="_blank">
				<i class="fa-brands fa-reddit"></i>
				<span>{{msg.home_footer_reddit}}</span>
			</a>
			<a href="https://www.youtube.com/@darkrockstudios/" target="_blank">
				<i class="fa-brands fa-youtube"></i>
				<span>{{msg.home_footer_youtube}}</span>
			</a>
			{{#patreonUrl}}
				<a href="{{patreonUrl}}" target="_blank" rel="noopener noreferrer">
					<i class="fa-brands fa-patreon"></i>
					<span>{{msg.home_footer_patreon}}</span>
				</a>
			{{/patreonUrl}}
		</div>
		<form action="/locale" method="post" class="language-selector">
			<label for="lang-select">Language:</label>
			<select id="lang-select" name="locale" hx-post="/locale" hx-trigger="change" hx-swap="none">
				{{#locales}}
					<option value="{{tag}}" {{#selected}}selected{{/selected}}>{{label}}</option>
				{{/locales}}
			</select>
			<noscript>
				<button type="submit">Change</button>
			</noscript>
		</form>
		{{#version}}
			<div class="footer-version">v{{version}}</div>
		{{/version}}
	</div>
</footer>

<!-- Toast Container for OOB swaps -->
<div id="toast-container" aria-live="polite" aria-atomic="false"></div>

<script src="/assets/js/toast.js"></script>
{{#page_pre_script}}
	<script src="{{page_pre_script}}"></script>
{{/page_pre_script}}
{{#page_script}}
	<script src="{{page_script}}"></script>
{{/page_script}}
</body>
</html>
