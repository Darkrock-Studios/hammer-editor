			<a href="https://github.com/Wavesonics/hammer-editor" target="_blank">
				<i class="fa-brands fa-github"></i>
				<span>{{msg.home_footer_github}}</span>
			</a>
			<a href="https://discord.gg/4ae6y4V4F5" target="_blank">
				<i class="fa-brands fa-discord"></i>
				<span>{{msg.home_footer_discord}}</span>
			</a>
			<a href="https://www.reddit.com/r/HammerEditor/" target="_blank">
				<i class="fa-brands fa-reddit"></i>
				<span>{{msg.home_footer_reddit}}</span>
