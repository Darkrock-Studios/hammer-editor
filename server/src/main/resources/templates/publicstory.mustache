{{> header}}

<main class="story-page public-story-page">
	<div class="story-container" data-reader-root>
		{{#isCoverPage}}
			{{> partials/reader-cover}}
		{{/isCoverPage}}

		<!-- Story Header -->
		<div class="story-header{{#isCoverPage}} story-header--cover-page{{/isCoverPage}}">
			<div class="public-story-attribution">
				<span class="by-line">{{msg.public_story_by}}</span>
				<a href="/a/{{authorPenNameUrl}}" class="author-name">{{authorPenName}}</a>
			</div>
			<h1 class="story-title">{{projectName}}</h1>
			{{#hasContent}}
				<div class="story-stats">
				<span class="stat-item">
					<i class="fa-solid fa-book-open"></i>
					{{formattedWordCount}} {{msg.public_story_words}}
				</span>
					<span class="stat-separator">|</span>
					<span class="stat-item">
					<i class="fa-regular fa-clock"></i>
						{{estimatedReadingTime}} {{msg.public_story_min_read}}
				</span>
				</div>
			{{/hasContent}}
		</div>

		{{#isCoverPage}}
			{{#hasContent}}
				<nav class="story-cover-start">
					<a href="{{startReadingUrl}}" class="reader-nav__link">
						{{msg.public_story_start_reading}}
						<i class="fas fa-arrow-right" aria-hidden="true"></i>
					</a>
				</nav>
			{{/hasContent}}
		{{/isCoverPage}}

		{{^isCoverPage}}
			<!-- Story Content -->
			{{#hasContent}}
				<div class="story-reading-bar">
					{{#hasPagination}}
						<span class="page-indicator">
							{{msg.admin_pagination_page}} {{currentPage}} {{msg.admin_pagination_of}} {{totalPages}}
						</span>
					{{/hasPagination}}
					<div class="reader-tools" role="toolbar" aria-label="{{msg.story_read_tools_label}}">
						{{> partials/reader-text-size}}
					</div>
				</div>
				{{> partials/reader-prefs}}
				<div id="story-page-content">
					{{> partials/story-page-content}}
				</div>
				{{#kudosFragmentUrl}}
					{{^hasNextPage}}
						<div class="story-kudos-slot" hx-get="{{kudosFragmentUrl}}" hx-trigger="intersect once" hx-swap="outerHTML"></div>
					{{/hasNextPage}}
				{{/kudosFragmentUrl}}
			{{/hasContent}}
		{{/isCoverPage}}
		{{^hasContent}}
			<article class="story-content">
				<div class="story-empty">
					<p>{{msg.story_no_scenes}}</p>
				</div>
			</article>
		{{/hasContent}}

		<!-- Public Footer Attribution -->
		<div class="public-story-footer">
			<p class="powered-by">{{msg.public_story_powered_by}} <a href="/">Hammer</a></p>
		</div>
	</div>
</main>

{{> footer}}
