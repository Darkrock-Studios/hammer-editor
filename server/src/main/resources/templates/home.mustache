{{> header}}

<!-- Masthead/Hero Section -->
<section class="masthead">
	<div class="masthead-content">
		<h1>{{msg.home_masthead_title}}</h1>
		<p class="masthead-tagline">{{msg.home_masthead_subtitle}}</p>
	</div>
</section>

<!-- About Server Callout (if configured) -->
{{#hasAboutPage}}
	<div class="about-server-callout">
		<a href="/about" class="about-server-callout__inner">
			<div class="about-server-callout__icon">
				<i class="fa-solid fa-info-circle"></i>
			</div>
			<div class="about-server-callout__content">
				<h2 class="about-server-callout__title">{{msg.home_about_callout_title}}</h2>
				<p class="about-server-callout__text">{{msg.home_about_callout_text}}</p>
			</div>
			<span class="about-server-callout__link">
				<i class="fa-solid fa-arrow-right"></i>
			</span>
		</a>
	</div>
{{/hasAboutPage}}

{{> partials/community-callout}}

<!-- Main Content -->
<main class="main-content">

	<!-- Server Message (if applicable) -->
	{{#serverMessage}}
		<div class="server-message">
			<h2>{{msg.home_servermessage}}</h2>
			<div>{{serverMessage}}</div>

			{{#whitelistEnabled}}
				<div class="whitelist-message">
					<p>{{msg.home_servermessage_whitelist}}</p>
				</div>
			{{/whitelistEnabled}}
		</div>
	{{/serverMessage}}

	<!-- What is Hammer Section -->
	<section class="paper-section">
		<div class="text-container">
			<h2>{{msg.home_whatishammer_title}}</h2>
			<p>{{msg.home_whatishammer_subtitle}}</p>
		</div>
	</section>

	<!-- Writing Features Divider -->
	<div class="section-divider">
		<span class="section-label">{{msg.home_section_writing}}</span>
		<div class="section-line"></div>
	</div>

	<!-- Detailed Features Section -->
	<section class="detailed-features">
		<div class="detailed-features-container">
			<div class="feature-detail">
				<div class="feature-detail-icon">
					<i class="fa-solid fa-file-lines"></i>
				</div>
				<div class="feature-detail-content">
					<h3>{{msg.home_detail_scenes_title}}</h3>
					<p>{{msg.home_detail_scenes_body}}</p>
				</div>
			</div>

			<div class="feature-detail">
				<div class="feature-detail-icon">
					<i class="fa-solid fa-arrows-up-down"></i>
				</div>
				<div class="feature-detail-content">
					<h3>{{msg.home_detail_organize_title}}</h3>
					<p>{{msg.home_detail_organize_body}}</p>
				</div>
			</div>

			<div class="feature-detail">
				<div class="feature-detail-icon">
					<i class="fa-solid fa-layer-group"></i>
				</div>
				<div class="feature-detail-content">
					<h3>{{msg.home_detail_drafts_title}}</h3>
					<p>{{msg.home_detail_drafts_body}}</p>
				</div>
			</div>

			<div class="feature-detail">
				<div class="feature-detail-icon">
					<i class="fa-solid fa-timeline"></i>
				</div>
				<div class="feature-detail-content">
					<h3>{{msg.home_detail_timeline_title}}</h3>
					<p>{{msg.home_detail_timeline_body}}</p>
				</div>
			</div>

			<div class="feature-detail">
				<div class="feature-detail-icon">
					<i class="fa-solid fa-book"></i>
				</div>
				<div class="feature-detail-content">
					<h3>{{msg.home_detail_encyclopedia_title}}</h3>
					<p>{{msg.home_detail_encyclopedia_body}}</p>
				</div>
			</div>

			<div class="feature-detail">
				<div class="feature-detail-icon">
					<i class="fa-solid fa-note-sticky"></i>
				</div>
				<div class="feature-detail-content">
					<h3>{{msg.home_detail_notes_title}}</h3>
					<p>{{msg.home_detail_notes_body}}</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Technical Features Divider -->
	<div class="section-divider">
		<span class="section-label">{{msg.home_section_technical}}</span>
		<div class="section-line"></div>
	</div>

	<!-- Features Grid -->
	<section>
		<div class="feature-grid">
			<div class="feature-card">
				<h3>{{msg.home_feature_multiplatform_header}}</h3>
				<p>{{msg.home_feature_multiplatform_body}}</p>
			</div>

			<div class="feature-card">
				<h3>{{msg.home_feature_multiscreen_header}}</h3>
				<p>{{msg.home_feature_multiscreen_body}}</p>
			</div>

			<div class="feature-card">
				<h3>{{msg.home_feature_offlinefirst_header}}</h3>
				<p>{{msg.home_feature_offlinefirst_body}}</p>
			</div>

			<div class="feature-card">
				<h3>{{msg.home_feature_transparentdata_header}}</h3>
				<p>{{msg.home_feature_transparentdata_body}}</p>
			</div>
		</div>
	</section>

	<!-- Decorative Divider -->
	<div class="divider"></div>

	<!-- Download Section -->
	<section class="paper-section download-section">
		<div class="text-container">
			<h2>{{msg.home_download_header}}</h2>
		</div>

		<div class="download-grid">
			<!-- Desktop Platforms - Row 1: Windows & macOS -->
			<div class="download-card" id="download">
				<span class="download-icon">🪟</span>
				<h3>{{msg.home_download_windows}}</h3>
				<div class="download-buttons download-selector">
					<select id="windows-format-select" class="format-dropdown"
							aria-label="{{msg.home_download_format_windows}}">
						<option value="store" data-icon="fa-brands fa-windows"
								data-url="https://apps.microsoft.com/detail/9p84lm8qv5x6">
							Microsoft Store
						</option>
						<option value="msi" data-icon="fa-solid fa-box"
								data-url="https://github.com/Darkrock-Studios/hammer-editor/releases/latest/download/hammer.msi">
							Installer (.msi)
						</option>
						<option value="exe" data-icon="fa-solid fa-file-zipper"
								data-url="https://github.com/Darkrock-Studios/hammer-editor/releases/latest/download/hammer.exe">
							Installer (.exe)
						</option>
					</select>
					<a id="windows-download-btn"
					   href="https://apps.microsoft.com/detail/9p84lm8qv5x6"
					   aria-label="{{msg.home_download_link_windows}}"
					   class="download-link download-btn"{{#analyticsEnabled}}
					   data-track-event="download" data-track-platform="windows" data-track-format="store"{{/analyticsEnabled}}>
						<i id="windows-download-icon" class="fa-brands fa-windows"></i>
						<span>{{msg.home_download_link}}</span>
					</a>
				</div>
			</div>

			<div class="download-card">
				<span class="download-icon">🍎</span>
				<h3>{{msg.home_download_macos}}</h3>
				<div class="download-buttons download-selector">
					<select id="macos-format-select" class="format-dropdown"
							aria-label="{{msg.home_download_format_macos}}">
						<option value="store" data-icon="fa-brands fa-app-store-ios"
						        data-url="https://apps.apple.com/us/app/hammer-editor/id6770841038">
							Mac App Store
						</option>
						<option value="dmg" data-icon="fa-solid fa-compact-disc"
								data-url="https://github.com/Darkrock-Studios/hammer-editor/releases/latest/download/hammer.dmg">
							Disk Image (.dmg)
						</option>
					</select>
					<a id="macos-download-btn"
					   href="https://apps.apple.com/us/app/hammer-editor/id6770841038"
					   aria-label="{{msg.home_download_link_macos}}"
					   class="download-link download-btn"{{#analyticsEnabled}}
					   data-track-event="download" data-track-platform="macos" data-track-format="store"{{/analyticsEnabled}}>
						<i id="macos-download-icon" class="fa-brands fa-app-store-ios"></i>
						<span>{{msg.home_download_link}}</span>
					</a>
				</div>
			</div>

			<!-- Desktop Platforms - Row 2: Linux -->
			<div class="download-card">
				<span class="download-icon">🐧</span>
				<h3>{{msg.home_download_linux}}</h3>
				<div class="download-buttons download-selector">
					<select id="linux-format-select" class="format-dropdown"
							aria-label="{{msg.home_download_format_linux}}">
						<option value="deb" data-icon="fa-brands fa-debian"
								data-url="https://github.com/Darkrock-Studios/hammer-editor/releases/latest/download/hammer.deb">
							Debian / Ubuntu (.deb)
						</option>
						<option value="rpm" data-icon="fa-brands fa-fedora"
								data-url="https://github.com/Darkrock-Studios/hammer-editor/releases/latest/download/hammer.rpm">
							Fedora / RHEL (.rpm)
						</option>
						<option value="appimage" data-icon="fa-solid fa-cube"
								data-url="https://github.com/Darkrock-Studios/hammer-editor/releases/latest/download/hammer.AppImage">
							AppImage (Universal)
						</option>
						<option value="flatpak" data-icon="fa-solid fa-box-open"
								data-url="https://github.com/Darkrock-Studios/hammer-editor/releases/latest/download/hammer.flatpak">
							Flatpak
						</option>
						<option value="snap" data-icon="fa-brands fa-snapchat"
								data-url="https://github.com/Darkrock-Studios/hammer-editor/releases/latest/download/hammer.snap">
							Snap (.snap)
						</option>
						<option value="snapstore" data-icon="fa-brands fa-snapchat"
								data-url="https://snapcraft.io/hammer-editor">
							Snapcraft.io
						</option>
					</select>
					<a id="linux-download-btn"
					   href="https://github.com/Darkrock-Studios/hammer-editor/releases/latest/download/hammer.deb"
					   aria-label="{{msg.home_download_link_linux}}"
					   class="download-link download-btn"{{#analyticsEnabled}}
					   data-track-event="download" data-track-platform="linux" data-track-format="deb"{{/analyticsEnabled}}>
						<i id="linux-download-icon" class="fa-brands fa-debian"></i>
						<span>{{msg.home_download_link}}</span>
					</a>
				</div>
			</div>

			<!-- Mobile Platforms - Row 2: Android & iOS -->
			<div class="download-card">
				<span class="download-icon">🤖</span>
				<h3>{{msg.home_download_android}}</h3>
				<div class="download-buttons download-selector">
					<select id="android-format-select" class="format-dropdown"
							aria-label="{{msg.home_download_format_android}}">
						<option value="playstore" data-icon="fa-brands fa-google-play"
								data-url="https://play.google.com/store/apps/details?id=com.darkrockstudios.apps.hammer.android">
							Google Play
						</option>
						<option value="fdroid" data-icon="fa-brands fa-android"
								data-url="https://f-droid.org/en/packages/com.darkrockstudios.apps.hammer.android/">
							F-Droid
						</option>
						<option value="apk" data-icon="fa-brands fa-github"
								data-url="https://github.com/Darkrock-Studios/hammer-editor/releases/latest/download/android.apk">
							GitHub (.apk)
						</option>
					</select>
					<a id="android-download-btn"
					   href="https://play.google.com/store/apps/details?id=com.darkrockstudios.apps.hammer.android"
					   aria-label="{{msg.home_download_link_android}}"
					   class="download-link download-btn"{{#analyticsEnabled}}
					   data-track-event="download" data-track-platform="android" data-track-format="playstore"{{/analyticsEnabled}}>
						<i id="android-download-icon" class="fa-brands fa-google-play"></i>
						<span>{{msg.home_download_link}}</span>
					</a>
				</div>
			</div>

			<div class="download-card">
				<span class="download-icon">🍎</span>
				<h3>iOS</h3>
				<span class="download-source"><i class="fa-brands fa-app-store-ios"></i> App Store</span>
				<a href="https://apps.apple.com/us/app/hammer-editor/id6771650681"
				   aria-label="{{msg.home_download_link_ios}}"
				   class="download-link download-btn"{{#analyticsEnabled}}
				   data-track-event="download" data-track-platform="ios" data-track-format="appstore"{{/analyticsEnabled}}>
					<i class="fa-brands fa-app-store-ios"></i>
					<span>{{msg.home_download_link}}</span>
				</a>
			</div>
		</div>
	</section>

</main>

{{> footer}}
