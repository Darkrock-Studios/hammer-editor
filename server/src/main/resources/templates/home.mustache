{{> header}}

<!-- Masthead/Hero Section -->
<section class="masthead">
	<div class="masthead-content">
		<h1>
			<span class="masthead-line">{{msg.home_masthead_title_first}}</span>
			<span class="masthead-line">{{msg.home_masthead_title_second}}</span>
		</h1>
		<p class="masthead-tagline">{{msg.home_masthead_subtitle}}</p>
		<div class="hero-actions">
			<a href="#download" class="hero-btn hero-btn--primary">
				<i class="fa-solid fa-download"></i>
				<span>{{msg.home_hero_download}}</span>
			</a>
		</div>
		<p class="hero-platforms">{{msg.home_hero_platforms}}</p>
	</div>

</section>

{{> partials/server-notice}}

<main class="page-main">

		<!-- Writing features, each shown rather than described -->
		<section class="showcase showcase--surface">
			<div class="showcase__inner">
				<p class="eyebrow">{{msg.home_features_eyebrow}}</p>
