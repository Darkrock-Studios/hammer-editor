	<!-- Inline so the visitor's own platform is promoted before first paint. -->
	<script>
		(function () {
			var ua = navigator.userAgent;
			var platform = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1) ? 'ios'
				: /Android/.test(ua) ? 'android'
				: /Windows/.test(ua) ? 'windows'
				: /Macintosh|Mac OS X/.test(ua) ? 'macos'
				: /Linux|X11|CrOS/.test(ua) ? 'linux' : null;
			var card = platform && document.querySelector('.dl[data-platform="' + platform + '"]');
			if (!card) return;
			var yours = document.getElementById('dl-yours');
			var others = document.getElementById('dl-others');
			yours.appendChild(card);
			yours.hidden = false;
			others.open = false;
			others.classList.add('dl-others--partial');
		})();
	</script>

