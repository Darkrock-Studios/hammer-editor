						<div class="feature-row__media">
							<img class="shot" src="/assets/images/screenshots/export-760.webp?v={{version}}"
								 srcset="/assets/images/screenshots/export-760.webp?v={{version}} 760w,
										 /assets/images/screenshots/export-1520.webp?v={{version}} 1520w"
								 sizes="(max-width: 52rem) 92vw, 44vw"
								 width="760" height="474" loading="lazy" decoding="async"
								 alt="{{msg.home_feature_export_alt}}">
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- The ownership argument, made once, after the reader has seen the app work -->
		<section class="showcase showcase--sunk">
			<div class="showcase__inner">
				<p class="eyebrow">{{msg.home_rules_eyebrow}}</p>
				<h2>{{msg.home_rules_title}}</h2>
				<p class="lede">{{msg.home_rules_lede}}</p>
				<div class="rules">
					<div class="rule">
						<p class="eyebrow"><i class="fa-solid fa-link-slash rule__icon" aria-hidden="true"></i>{{msg.home_rule_offline_name}}</p>
						<h3>{{msg.home_rule_offline_title}}</h3>
						<p>{{msg.home_rule_offline_body}}</p>
					</div>
					<div class="rule">
						<p class="eyebrow"><i class="fa-solid fa-folder-open rule__icon" aria-hidden="true"></i>{{msg.home_rule_files_name}}</p>
						<h3>{{msg.home_rule_files_title}}</h3>
						<p>{{msg.home_rule_files_body}}</p>
					</div>
					<div class="rule">
						<p class="eyebrow"><i class="fa-solid fa-shield-halved rule__icon" aria-hidden="true"></i>{{msg.home_rule_safety_name}}</p>
						<h3>{{msg.home_rule_safety_title}}</h3>
						<p>{{msg.home_rule_safety_body}}</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Origin story: credibility for the rules above, once the reader cares -->
		<section class="showcase">
			<div class="showcase__inner">
				<p class="eyebrow">{{msg.home_origin_eyebrow}}</p>
				<h2>{{msg.home_origin_title}}</h2>
				<div class="origin">
					<figure class="origin__media">
							<img class="shot" src="/assets/images/origin-van-760.webp?v={{version}}"
								 srcset="/assets/images/origin-van-760.webp?v={{version}} 760w,
										 /assets/images/origin-van-1520.webp?v={{version}} 1520w"
								 sizes="(max-width: 52rem) 92vw, 44vw"
								 width="760" height="950" loading="lazy" decoding="async"
								 alt="{{msg.home_origin_alt}}">
							<figcaption class="origin__caption">{{msg.home_origin_caption}}</figcaption>
						</figure>
					<div class="origin__copy">
						<p>{{msg.home_origin_body1}}</p>
						<p>{{msg.home_origin_body2}}</p>
						<p>{{msg.home_origin_body3}}</p>
						<p class="origin__link">
							<a href="https://hammer.ink/blog/news/what-is-hammer">{{msg.home_origin_link}} <i class="fa-solid fa-arrow-right"></i></a>
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Price, stated plainly -->
		<section class="showcase showcase--sunk">
			<div class="showcase__inner price">
				<p class="eyebrow">{{msg.home_price_eyebrow}}</p>
				<h2 class="price__amount">{{msg.home_price_amount}}</h2>
				<p class="price__body">{{msg.home_price_body}}</p>
			</div>
		</section>

