{{> header}}

<section class="masthead">
	<div class="masthead-content">
		<h1>
			<span class="masthead-line">{{msg.home_masthead_title_first}}</span>
			<span class="masthead-line">{{msg.home_masthead_title_second}}</span>
		</h1>
		<p class="masthead-tagline">{{msg.home_masthead_lede}}</p>
	</div>
</section>

{{> partials/server-notice}}

<main class="page-main">

	{{> partials/home-download}}

	<section class="showcase showcase--surface" id="features">
		<div class="showcase__inner">
			<p class="eyebrow">{{msg.home_features_label}}</p>
			<h2>{{msg.home_features_heading}}</h2>

			<div class="tablist" role="tablist" aria-label="{{msg.home_features_label}}">
				<button class="tab" type="button" role="tab" id="tab-write" aria-controls="panel-write" aria-selected="true">
					<i class="fa-solid fa-pen-nib" aria-hidden="true"></i>{{msg.home_tab_write}}
				</button>
				<button class="tab" type="button" role="tab" id="tab-world" aria-controls="panel-world" aria-selected="false" tabindex="-1">
					<i class="fa-solid fa-earth-europe" aria-hidden="true"></i>{{msg.home_tab_world}}
				</button>
				<button class="tab" type="button" role="tab" id="tab-share" aria-controls="panel-share" aria-selected="false" tabindex="-1">
					<i class="fa-solid fa-paper-plane" aria-hidden="true"></i>{{msg.home_tab_share}}
				</button>
				<button class="tab" type="button" role="tab" id="tab-sync" aria-controls="panel-sync" aria-selected="false" tabindex="-1">
					<i class="fa-solid fa-rotate" aria-hidden="true"></i>{{msg.home_tab_sync}}
				</button>
			</div>

			<div class="tabpanel" role="tabpanel" id="panel-write" aria-labelledby="tab-write">
				<div class="slides" data-label="{{msg.home_slide_label}}">
					<div class="slides__frame">
						{{#shots_write}}
							<img class="slides__img{{#first}} is-active{{/first}}"
								 src="/assets/images/screenshots/{{name}}-760.webp?v={{version}}"
								 srcset="/assets/images/screenshots/{{name}}-760.webp?v={{version}} 760w,
										 /assets/images/screenshots/{{name}}-1520.webp?v={{version}} 1520w"
								 sizes="(max-width: 56rem) 92vw, 48vw"
								 width="760" height="{{height}}" loading="lazy" decoding="async"
								 alt="{{alt}}">
						{{/shots_write}}
					</div>
				</div>
				<div>
					<h3 class="tabpanel__title">{{msg.home_tab_write}}</h3>
					<p>{{msg.home_tab_write_intro}}</p>
					<ul class="feat-list">
						<li><strong>{{msg.home_feat_editor_name}}</strong>{{msg.home_feat_editor_body}}</li>
						<li><strong>{{msg.home_feat_chapters_name}}</strong>{{msg.home_feat_chapters_body}}</li>
						<li><strong>{{msg.home_feat_formatting_name}}</strong>{{msg.home_feat_formatting_body}}</li>
						<li><strong>{{msg.home_feat_notes_name}}</strong>{{msg.home_feat_notes_body}}</li>
						<li><strong>{{msg.home_feat_activity_name}}</strong>{{msg.home_feat_activity_body}}</li>
					</ul>
				</div>
			</div>

			<div class="tabpanel" role="tabpanel" id="panel-world" aria-labelledby="tab-world" hidden>
				<div class="slides" data-label="{{msg.home_slide_label}}">
					<div class="slides__frame">
						{{#shots_world}}
							<img class="slides__img{{#first}} is-active{{/first}}"
								 src="/assets/images/screenshots/{{name}}-760.webp?v={{version}}"
								 srcset="/assets/images/screenshots/{{name}}-760.webp?v={{version}} 760w,
										 /assets/images/screenshots/{{name}}-1520.webp?v={{version}} 1520w"
								 sizes="(max-width: 56rem) 92vw, 48vw"
								 width="760" height="{{height}}" loading="lazy" decoding="async"
								 alt="{{alt}}">
						{{/shots_world}}
					</div>
				</div>
				<div>
					<h3 class="tabpanel__title">{{msg.home_tab_world}}</h3>
					<p>{{msg.home_tab_world_intro}}</p>
					<ul class="feat-list">
						<li><strong>{{msg.home_feat_encyclopedia_name}}</strong>{{msg.home_feat_encyclopedia_body}}</li>
						<li><strong>{{msg.home_feat_images_name}}</strong>{{msg.home_feat_images_body}}</li>
						<li><strong>{{msg.home_feat_timelines_name}}</strong>{{msg.home_feat_timelines_body}}</li>
						<li><strong>{{msg.home_feat_rename_name}}</strong>{{msg.home_feat_rename_body}}</li>
					</ul>
				</div>
			</div>

			<div class="tabpanel" role="tabpanel" id="panel-share" aria-labelledby="tab-share" hidden>
				<div class="slides" data-label="{{msg.home_slide_label}}">
					<div class="slides__frame">
						{{#shots_share}}
							<img class="slides__img{{#first}} is-active{{/first}}"
								 src="/assets/images/screenshots/{{name}}-760.webp?v={{version}}"
								 srcset="/assets/images/screenshots/{{name}}-760.webp?v={{version}} 760w,
										 /assets/images/screenshots/{{name}}-1520.webp?v={{version}} 1520w"
								 sizes="(max-width: 56rem) 92vw, 48vw"
								 width="760" height="{{height}}" loading="lazy" decoding="async"
								 alt="{{alt}}">
						{{/shots_share}}
					</div>
				</div>
				<div>
					<h3 class="tabpanel__title">{{msg.home_tab_share}}</h3>
					<p>{{msg.home_tab_share_intro}}</p>
					<ul class="feat-list">
						<li><strong>{{msg.home_feat_review_name}}</strong>{{msg.home_feat_review_body}}</li>
						<li><strong>{{msg.home_feat_coauthoring_name}}</strong>{{msg.home_feat_coauthoring_body}}</li>
						<li><strong>{{msg.home_feat_private_name}}</strong>{{msg.home_feat_private_body}}</li>
						<li><strong>{{msg.home_feat_publish_name}}</strong>{{msg.home_feat_publish_body}}</li>
						<li><strong>{{msg.home_feat_export_name}}</strong>{{msg.home_feat_export_body}}</li>
					</ul>
				</div>
			</div>

			<div class="tabpanel" role="tabpanel" id="panel-sync" aria-labelledby="tab-sync" hidden>
				<div>
					<h3 class="feat-group">{{msg.home_sync_title}}</h3>
					<p>{{msg.home_sync_intro}}</p>
					<ul class="feat-list">
						<li><strong>{{msg.home_feat_sync_name}}</strong>{{msg.home_feat_sync_body}}</li>
						<li><strong>{{msg.home_feat_conflicts_name}}</strong>{{msg.home_feat_conflicts_body}}</li>
						<li><strong>{{msg.home_feat_security_name}}</strong>{{msg.home_feat_security_body}}</li>
					</ul>
				</div>
				<div>
					<h3 class="feat-group">{{msg.home_plugins_title}}</h3>
					<p>{{msg.home_plugins_intro}}</p>
					<ul class="feat-list">
						<li><strong>{{msg.home_feat_grammar_name}}</strong>{{msg.home_feat_grammar_body}}</li>
						<li><strong>{{msg.home_feat_names_name}}</strong>{{msg.home_feat_names_body}}</li>
						<li><strong>{{msg.home_feat_mcp_name}}</strong>{{msg.home_feat_mcp_body}}</li>
					</ul>
					<p class="feat-links">
						<a class="more" href="{{pluginsUrl}}" target="_blank" rel="noopener noreferrer">{{msg.home_plugins_browse}} <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
						<a class="more" href="{{developersUrl}}" target="_blank" rel="noopener noreferrer">{{msg.home_plugins_build}} <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
					</p>
				</div>
			</div>
			<!-- Without scripting the tabs can't switch, so every panel is laid out in turn. -->
			<noscript>
				<style>
					.tablist { display: none; }
					.tabpanel[hidden] { display: grid; }
					.tabpanel { margin-bottom: 1.5rem; }
					.tabpanel__title { display: block; }
				</style>
			</noscript>
		</div>
	</section>

	<section class="showcase showcase--sunk">
		<div class="showcase__inner">
			<p class="eyebrow">{{msg.home_principles_label}}</p>
			<h2>{{msg.home_principles_heading}}</h2>
			{{> partials/home-principles}}
			{{#hasMorePrinciples}}
				<p class="principles-more">
					<span>{{msg.home_principles_more}}</span>
					{{#morePrinciples}}
						<a href="{{url}}">{{title}}</a>
					{{/morePrinciples}}
				</p>
			{{/hasMorePrinciples}}
		</div>
	</section>

	<section class="showcase">
		<div class="showcase__inner learn">
			<div>
				<p class="eyebrow">{{msg.home_tutorials_label}}</p>
				<h2>{{msg.home_tutorials_heading}}</h2>
				<a class="video-card" href="{{tutorialsUrl}}" target="_blank" rel="noopener noreferrer">
					<span class="video-card__thumb">
						<img src="/assets/images/tutorials-760.webp?v={{version}}"
							 srcset="/assets/images/tutorials-760.webp?v={{version}} 760w,
									 /assets/images/tutorials-1520.webp?v={{version}} 1520w"
							 sizes="(max-width: 56rem) 92vw, 48vw"
							 width="760" height="428" loading="lazy" decoding="async" alt="">
						<span class="video-card__play"><i class="fa-solid fa-play" aria-hidden="true"></i></span>
					</span>
					<span class="video-card__body">
						<span>{{msg.home_tutorials_body}}</span>
						<span class="more">{{msg.home_tutorials_link}} <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></span>
					</span>
				</a>
			</div>
			{{#hasBlogPosts}}
				<div>
					<p class="eyebrow">{{msg.home_blog_label}}</p>
					<h2>{{msg.home_blog_heading}}</h2>
					<ul class="posts">
						{{#blogPosts}}
							<li>
								{{#date}}<time datetime="{{isoDate}}">{{date}}</time>{{/date}}
								<a href="{{url}}">{{title}}</a>
							</li>
						{{/blogPosts}}
					</ul>
					{{#blogUrl}}
						<p class="posts__all"><a class="more" href="{{blogUrl}}">{{msg.home_blog_all}} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></p>
					{{/blogUrl}}
				</div>
			{{/hasBlogPosts}}
		</div>
	</section>

	<section class="showcase showcase--sunk">
		<div class="showcase__inner">
			<p class="eyebrow">{{msg.home_origin_eyebrow}}</p>
			<h2>{{msg.home_origin_title}}</h2>
			<div class="origin">
				<figure class="origin__media">
						<img class="shot" src="/assets/images/origin-van-760.webp?v={{version}}"
							 srcset="/assets/images/origin-van-760.webp?v={{version}} 760w,
									 /assets/images/origin-van-1520.webp?v={{version}} 1520w"
							 sizes="(max-width: 52rem) 92vw, 44vw"
							 width="760" height="950" loading="lazy" decoding="async"
							 alt="{{msg.home_origin_alt}}">
						<figcaption class="origin__caption">{{msg.home_origin_caption}}</figcaption>
					</figure>
				<div class="origin__copy">
					<p>{{msg.home_origin_body1}}</p>
					<p>{{msg.home_origin_body2}}</p>
					<p>{{msg.home_origin_body3}}</p>
					<p class="origin__link">
						<a href="{{originStoryUrl}}">{{msg.home_origin_link}} <i class="fa-solid fa-arrow-right"></i></a>
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="showcase">
		<div class="showcase__inner">
			<h2>{{msg.home_faq_title}}</h2>
			<div class="faq">
				<details open>
					<summary>{{msg.home_faq_account_q}}</summary>
					<p>{{msg.home_faq_account_answer}}</p>
				</details>
				<details>
					<summary>{{msg.home_faq_where_q}}</summary>
					<p>{{msg.home_faq_where_answer}}</p>
				</details>
				<details>
					<summary>{{msg.home_faq_privacy_q}}</summary>
					<p>{{msg.home_faq_privacy_answer}}</p>
				</details>
				<details>
					<summary>{{msg.home_faq_goesaway_q}}</summary>
					<p>{{msg.home_faq_goesaway_answer}}</p>
				</details>
			</div>
		</div>
	</section>

</main>

{{> footer}}
