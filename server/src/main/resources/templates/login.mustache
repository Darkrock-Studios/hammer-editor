{{> header}}

<main class="page page--centered">
	<div class="page__container page__container--narrow">
		<div class="paper-section paper-section--compact">
			<div class="login-header">
				<h1>{{msg.login_title}}</h1>
				<p>{{msg.login_subtitle}}</p>
			</div>

			<form action="/login" method="post" class="login-form">
				<div class="form-field">
					<label for="email" class="form-field__label">{{msg.login_email_label}}</label>
					<input type="email" id="email" name="email" class="form-input" required autofocus
						   placeholder="{{msg.login_email_placeholder}}">
				</div>

				<div class="form-field">
					<label for="password" class="form-field__label">{{msg.login_password_label}}</label>
					<input type="password" id="password" name="password" class="form-input" required
						   placeholder="{{msg.login_password_placeholder}}">
				</div>

				{{#message}}
					<div class="login-message">
						<p>{{message}}</p>
					</div>
				{{/message}}

				<div class="form-actions">
					<button type="submit" class="login-button">{{msg.login_signin_button}}</button>
				</div>
			</form>

			<div class="login-info">
				<p class="login-info-text">
					<a href="/forgot-password">{{msg.password_reset_forgot_link}}</a>
				</p>
				<p class="login-info-text">{{msg.login_info_create_account}}</p>
				{{#patreonEnabled}}
					<div class="login-info-patreon">
						<h3 class="login-info-patreon__title">{{msg.login_patreon_notice_title}}</h3>
						<p>{{patreonMessage}}</p>
						<a href="{{patreonUrl}}" target="_blank" rel="noopener noreferrer"
						   class="login-info-patreon__link">
							{{msg.login_patreon_notice_link}} →
						</a>
					</div>
				{{/patreonEnabled}}
				{{^patreonEnabled}}
					<div class="login-info-whitelist">
						<p>{{msg.login_info_whitelist_notice}}</p>
						{{#contactEmail}}
							<p>{{msg.login_info_whitelist_contact}} <a
								href="mailto:{{contactEmail}}">{{contactEmail}}</a></p>
						{{/contactEmail}}
					</div>
				{{/patreonEnabled}}
			</div>
		</div>
	</div>
</main>

{{> footer}}
