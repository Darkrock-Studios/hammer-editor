{{> header}}

<main class="page">
	<div class="admin-layout">
		{{> partials/admin-nav}}

		<div class="admin-content">
			<!-- Admin Header -->
			<div class="page-header">
				<div class="page-header__content">
					<h1 class="page-header__title">{{msg.admin_dashboard_title}}</h1>
					<p class="page-header__subtitle">{{msg.admin_dashboard_subtitle}}</p>
				</div>
			</div>

			<!-- Server Settings Section -->
			<section class="paper-section">
				<div class="section-header">
					<h2 class="section-header__title">{{msg.admin_serversettings_title}}</h2>
				</div>
				<p class="section-description">{{msg.admin_serversettings_description}}</p>

				<form action="/admin/settings" method="post" class="settings-form"
					  hx-post="/admin/settings"
					  hx-swap="none">
					<div class="form-group">
						<label for="contact"
							   class="form-field__label">{{msg.admin_serversettings_contact_label}}</label>
						<div class="form-input-group">
							<input id="contact" name="contact" type="email" value="{{contactEmail}}" class="form-input"
								   placeholder="{{msg.admin_serversettings_contact_placeholder}}"/>
						</div>
					</div>

					<div class="form-group">
						<label for="defaultLocale"
							   class="form-field__label">{{msg.admin_serversettings_default_locale_label}}</label>
						<div class="form-input-group">
							<select id="defaultLocale" name="defaultLocale" class="form-select">
								{{#availableLocales}}
									<option value="{{tag}}" {{#selected}}selected{{/selected}}>{{label}}</option>
								{{/availableLocales}}
							</select>
						</div>
					</div>

					<div class="form-group">
						<label for="message"
							   class="form-field__label">{{msg.admin_serversettings_message_label}}</label>
						<p class="form-field__help">{{msg.admin_serversettings_message_help}}</p>
						<div class="form-input-group">
							<textarea id="message" name="message" rows="4"
									  class="form-textarea">{{serverMessage}}</textarea>
						</div>
					</div>

					<div class="form-group">
						<label for="about"
							   class="form-field__label">{{msg.admin_serversettings_about_label}}</label>
						<p class="form-field__help">{{msg.admin_serversettings_about_help}}</p>
						<div class="form-input-group">
							<textarea id="about" name="about" rows="10" maxlength="4096"
									  class="form-textarea">{{aboutServer}}</textarea>
						</div>
					</div>

					<hr class="settings-divider"/>
					<h3 class="settings-subheading">{{msg.admin_mon_settings_title}}</h3>
					<p class="form-field__help">{{msg.admin_mon_settings_help}}</p>

					<div class="form-group form-check">
						<label class="form-check__label">
							<input type="checkbox" name="monEnabled" {{#monEnabled}}checked{{/monEnabled}}/>
							{{msg.admin_mon_settings_enabled}}
						</label>
					</div>
					<div class="form-group form-check">
						<label class="form-check__label">
							<input type="checkbox" name="monTrackApiMetrics" {{#monTrackApiMetrics}}checked{{/monTrackApiMetrics}}/>
							{{msg.admin_mon_settings_track_api}}
						</label>
					</div>
					<div class="form-group form-check">
						<label class="form-check__label">
							<input type="checkbox" name="monTrackErrors" {{#monTrackErrors}}checked{{/monTrackErrors}}/>
							{{msg.admin_mon_settings_track_errors}}
						</label>
					</div>
					<div class="form-group form-check">
						<label class="form-check__label">
							<input type="checkbox" name="monTrackLoginAttempts" {{#monTrackLoginAttempts}}checked{{/monTrackLoginAttempts}}/>
							{{msg.admin_mon_settings_track_logins}}
						</label>
					</div>
					<div class="form-group form-check">
						<label class="form-check__label">
							<input type="checkbox" name="monStoreLoginIp" {{#monStoreLoginIp}}checked{{/monStoreLoginIp}}/>
							{{msg.admin_mon_settings_store_ip}}
						</label>
					</div>
					<div class="form-group form-check">
						<label class="form-check__label">
							<input type="checkbox" name="monPrometheus" {{#monPrometheus}}checked{{/monPrometheus}}/>
							{{msg.admin_mon_settings_prometheus}}
						</label>
					</div>

					<div class="form-group">
						<label for="monMetricsRetention" class="form-field__label">{{msg.admin_mon_settings_metrics_retention}}</label>
						<input id="monMetricsRetention" name="monMetricsRetention" type="number" min="1" max="3650"
							   value="{{monMetricsRetention}}" class="form-input"/>
					</div>
					<div class="form-group">
						<label for="monErrorRetention" class="form-field__label">{{msg.admin_mon_settings_error_retention}}</label>
						<input id="monErrorRetention" name="monErrorRetention" type="number" min="1" max="3650"
							   value="{{monErrorRetention}}" class="form-input"/>
					</div>
					<div class="form-group">
						<label for="monLoginRetention" class="form-field__label">{{msg.admin_mon_settings_login_retention}}</label>
						<input id="monLoginRetention" name="monLoginRetention" type="number" min="1" max="3650"
							   value="{{monLoginRetention}}" class="form-input"/>
					</div>

					<div class="form-group form-check">
						<label class="form-check__label">
							<input type="checkbox" name="monAlertEmailEnabled" {{#monAlertEmailEnabled}}checked{{/monAlertEmailEnabled}}/>
							{{msg.admin_mon_settings_alert_email_enabled}}
						</label>
					</div>
					<div class="form-group">
						<label for="monAlertEmail" class="form-field__label">{{msg.admin_mon_settings_alert_email}}</label>
						<input id="monAlertEmail" name="monAlertEmail" type="email" value="{{monAlertEmail}}" class="form-input"
							   placeholder="admin@example.com"/>
					</div>

					<div class="form-actions">
						<button type="submit" class="save-button">{{msg.admin_serversettings_save_button}}</button>
					</div>
				</form>
			</section>
		</div>
	</div>
</main>

<div id="result"></div>
{{> footer}}
