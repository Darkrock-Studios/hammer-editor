{{> header}}

<main class="page page--centered">
	<div class="page__container page__container--narrow">
		<div class="paper-section paper-section--compact">
			<div class="login-header">
				<h1>{{msg.password_reset_forgot_title}}</h1>
				<p>{{msg.password_reset_forgot_subtitle}}</p>
			</div>

			{{#success}}
				<div class="password-reset-success">
					<div class="password-reset-success__icon">✉️</div>
					<p class="password-reset-success__message">{{msg.password_reset_email_sent}}</p>
					<p class="password-reset-success__detail">{{msg.password_reset_check_email}}
						<strong>{{email}}</strong></p>
					<p class="password-reset-success__help">{{msg.password_reset_link_expires}}</p>
				</div>
				<div class="form-actions">
					<a href="/login" class="login-button">{{msg.password_reset_back_to_login}}</a>
				</div>
			{{/success}}

			{{^success}}
				<form action="/forgot-password" method="post" class="login-form">
					<div class="form-field">
						<label for="email" class="form-field__label">{{msg.login_email_label}}</label>
						<input type="email" id="email" name="email" class="form-input" required autofocus
							   placeholder="{{msg.login_email_placeholder}}" autocomplete="email">
						<p class="form-field__help">{{msg.password_reset_enter_email_help}}</p>
					</div>

					{{#error}}
						<div class="login-message">
							<p>{{error}}</p>
						</div>
					{{/error}}

					<div class="form-actions">
						<button type="submit" class="login-button">{{msg.password_reset_send_link}}</button>
					</div>
				</form>

				<div class="login-info">
					<p class="login-info-text">
						<a href="/login">{{msg.password_reset_back_to_login}}</a>
					</p>
				</div>
			{{/success}}
		</div>
	</div>
</main>

{{> footer}}
