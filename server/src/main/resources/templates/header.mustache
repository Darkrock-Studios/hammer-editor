<!DOCTYPE html>
<html lang="{{locale}}" class="fa-pending">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{title}}</title>
	{{#metaDescription}}
		<meta name="description" content="{{metaDescription}}">
	{{/metaDescription}}
	{{#canonicalUrl}}
		<link rel="canonical" href="{{canonicalUrl}}">
	{{/canonicalUrl}}
	<meta property="og:site_name" content="Hammer">
	<meta property="og:type" content="{{ogType}}">
	<meta property="og:title" content="{{title}}">
	{{#metaDescription}}
		<meta property="og:description" content="{{metaDescription}}">
	{{/metaDescription}}
	{{#canonicalUrl}}
		<meta property="og:url" content="{{canonicalUrl}}">
	{{/canonicalUrl}}
	{{#ogImage}}
		<meta property="og:image" content="{{ogImage}}">
	{{/ogImage}}
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:title" content="{{title}}">
	{{#metaDescription}}
		<meta name="twitter:description" content="{{metaDescription}}">
	{{/metaDescription}}
	{{#ogImage}}
		<meta name="twitter:image" content="{{ogImage}}">
	{{/ogImage}}
	{{#jsonLd}}
		<script type="application/ld+json">{{{.}}}</script>
	{{/jsonLd}}
	<link rel="icon" type="image/x-icon" href="/assets/favicon.ico">

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>

	<!-- Every heading uses this face. Without the preload it isn't discovered until base.css parses,
	     and font-display: swap then reflows the whole page once it lands. The href carries no
	     version stamp so it matches the request base.css issues byte for byte. -->
	<link rel="preload" as="font" type="font/woff2" href="/assets/Kingthings_Trypewriter_2.woff2" crossorigin>
	{{#preloadImages}}
		<link rel="preload" as="image" href="{{href}}" type="{{type}}" fetchpriority="high"{{#media}} media="{{media}}"{{/media}}>
	{{/preloadImages}}

	<link rel="stylesheet" href="/assets/css/base.css?v={{assetVersion}}">
	{{#page_stylesheet}}
		<link rel="stylesheet" href="{{page_stylesheet}}?v={{assetVersion}}">
	{{/page_stylesheet}}
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;1,400&amp;display=swap">

	<!-- Font Awesome is decorative: fetched at print media so it can't block render, then switched
	     to all media by async-css.js once it lands. -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
		integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
		crossorigin="anonymous" media="print" data-async-css>
	<noscript>
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
			integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
			crossorigin="anonymous">
	</noscript>
	<script defer src="/assets/js/async-css.js?v={{assetVersion}}"></script>

	<script defer src="https://unpkg.com/htmx.org@2.0.4"
		integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+"
		crossorigin="anonymous"></script>
	{{#analyticsEnabled}}
		{{{analyticsHead}}}
		<script>{{{analyticsBridge}}}</script>
		<script defer src="/assets/js/analytics.js?v={{assetVersion}}"></script>
	{{/analyticsEnabled}}
</head>
<body>
<header class="site-header">
	{{#isDev}}
		<div class="dev-banner" aria-hidden="true">
			<div class="dev-banner__track">
				<span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span>
			</div>
			<div class="dev-banner__track" aria-hidden="true">
				<span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span><span>development</span>
			</div>
		</div>
	{{/isDev}}
	<div class="header-container">
		<a href="/" class="site-logo">
			<img src="/assets/images/hammer_icon_sm.png?v={{assetVersion}}" alt="Hammer Editor" width="40" height="40">
			<span class="site-title">Hammer</span>
		</a>

		<!-- Mobile hamburger button -->
		<button class="nav-toggle" aria-label="{{msg.header_nav_toggle}}" aria-expanded="false">
			<i class="fa-solid fa-bars nav-toggle__icon nav-toggle__icon--open"></i>
			<i class="fa-solid fa-xmark nav-toggle__icon nav-toggle__icon--close"></i>
		</button>

		<nav class="header-nav" id="header-nav">
			{{#hasAboutPage}}
				<a href="/about" class="header-nav__link" title="{{msg.header_nav_about}}">
					<i class="fa-solid fa-info-circle"></i>
					<span class="header-nav__label">{{msg.header_nav_about}}</span>
				</a>
			{{/hasAboutPage}}
			{{#communityEnabled}}
				<a href="/community/feed" class="header-nav__link" title="{{msg.header_nav_community}}">
					<i class="fa-solid fa-users"></i>
					<span class="header-nav__label">{{msg.header_nav_community}}</span>
				</a>
			{{/communityEnabled}}
			{{#headerExtraLinks}}
				<a href="{{url}}" class="header-nav__link" title="{{title}}"{{#external}} target="_blank" rel="noopener noreferrer"{{/external}}>
					<i class="{{icon}}"></i>
					<span class="header-nav__label">{{title}}</span>
				</a>
			{{/headerExtraLinks}}
			{{#isLoggedIn}}
				<a href="/dashboard" class="header-nav__link header-nav__link--primary"
				   title="{{msg.header_nav_dashboard}}">
					<i class="fa-solid fa-gauge-high"></i>
					<span class="header-nav__label">{{msg.header_nav_dashboard}}</span>
				</a>
			{{/isLoggedIn}}
			{{^isLoggedIn}}
				<a href="/login" class="header-nav__link header-nav__link--primary" title="{{msg.header_nav_login}}">
					<i class="fa-solid fa-right-to-bracket"></i>
					<span class="header-nav__label">{{msg.header_nav_login}}</span>
				</a>
			{{/isLoggedIn}}
		</nav>
	</div>
</header>
<div class="nav-overlay" id="nav-overlay"></div>
<script>
	(function () {
		const toggle = document.querySelector('.nav-toggle');
		const nav = document.getElementById('header-nav');
		const overlay = document.getElementById('nav-overlay');

		function closeMenu() {
			toggle.setAttribute('aria-expanded', 'false');
			nav.classList.remove('is-open');
			overlay.classList.remove('is-visible');
			document.body.style.overflow = '';
		}

		function openMenu() {
			toggle.setAttribute('aria-expanded', 'true');
			nav.classList.add('is-open');
			overlay.classList.add('is-visible');
			document.body.style.overflow = 'hidden';
		}

		toggle.addEventListener('click', function () {
			const isOpen = toggle.getAttribute('aria-expanded') === 'true';
			if (isOpen) {
				closeMenu();
			} else {
				openMenu();
			}
		});

		overlay.addEventListener('click', closeMenu);

		// Close menu when clicking a nav link
		nav.querySelectorAll('.header-nav__link').forEach(function (link) {
			link.addEventListener('click', closeMenu);
		});

		// Close on escape key
		document.addEventListener('keydown', function (e) {
			if (e.key === 'Escape') closeMenu();
		});
	})();
</script>
