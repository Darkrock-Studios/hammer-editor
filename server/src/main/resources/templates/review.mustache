{{> header}}

<main class="review-page">
	<div class="review-page__container">

		<!-- Review masthead -->
		<div class="review-masthead">
			<div class="review-masthead__title-block">
				<span class="review-masthead__overline">{{msg.review_page_overline}}</span>
				<h1 class="review-masthead__title">{{projectName}}
					<span class="review-masthead__author">&mdash; {{msg.review_page_by}} {{authorName}}</span>
				</h1>
			</div>
			<div class="review-masthead__actions">
				<div class="review-masthead__reviewer">
					<span class="review-masthead__email"><i class="fa-solid fa-user-pen"></i> {{reviewerEmail}}</span>
					{{#hasExpiry}}
						<span class="review-masthead__expiry">{{expiryLine}}</span>
					{{/hasExpiry}}
				</div>
				{{^locked}}
					<button class="btn btn--accent review-submit-btn" id="review-submit-btn" type="button">
						<i class="fa-solid fa-paper-plane"></i> {{msg.review_submit}}
					</button>
				{{/locked}}
				{{#locked}}
					<span class="review-submitted-pill"><i class="fa-solid fa-lock"></i> {{msg.review_status_submitted}}</span>
				{{/locked}}
			</div>
		</div>

		{{#locked}}
			<div class="review-locked-banner">
				<i class="fa-solid fa-lock"></i>
				<span>{{msg.review_locked_banner}}</span>
			</div>
		{{/locked}}

		{{#hasNote}}
			<div class="review-note">
				<span class="review-note__title"><i class="fa-solid fa-thumbtack"></i> {{msg.review_page_note_title}}</span>
				<p class="review-note__body">{{note}}</p>
			</div>
		{{/hasNote}}

		{{^locked}}
			<div class="review-hint" id="review-hint">
				<i class="fa-solid fa-highlighter"></i>
				<span>{{msg.review_hint}}</span>
			</div>
		{{/locked}}

		<!-- review.js renders the scene nav + manuscript + gutter into here -->
		<div class="review-editor" id="review-editor"></div>

	</div>
</main>

<script type="application/json" id="review-data">{{{reviewData}}}</script>
<script type="application/json" id="review-strings">{
	"reword": "{{msg.review_action_reword}}",
	"delete": "{{msg.review_action_delete}}",
	"insert": "{{msg.review_action_insert}}",
	"insertHere": "{{msg.review_action_insert_here}}",
	"comment": "{{msg.review_action_comment}}",
	"save": "{{msg.review_action_save}}",
	"cancel": "{{msg.review_dialog_cancel}}",
	"remove": "{{msg.review_action_remove}}",
	"removeConfirm": "{{msg.review_action_remove_confirm}}",
	"replacementLabel": "{{msg.review_action_replacement_label}}",
	"insertLabel": "{{msg.review_action_insert_label}}",
	"commentLabel": "{{msg.review_action_comment_label}}",
	"reasonPlaceholder": "{{msg.review_action_reason_placeholder}}",
	"commentPlaceholder": "{{msg.review_action_comment_placeholder}}",
	"typePlaceholder": "{{msg.review_action_type_placeholder}}",
	"suggestionsTitle": "{{msg.review_suggestions_title}}",
	"noSuggestions": "{{msg.review_no_suggestions}}",
	"scenesTitle": "{{msg.review_scenes_title}}",
	"submitConfirm": "{{msg.review_submit_confirm}}",
	"saveFailed": "{{msg.review_save_failed}}"
}</script>

{{> footer}}
