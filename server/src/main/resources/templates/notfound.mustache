{{> header}}

<main class="page page--centered">
	<div class="page__container page__container--error">
		<div class="error-card notfound">
			<div class="error-icon">📄</div>
			<h1 class="error-title">{{msg.error_notfound_title}}</h1>
			<div class="error-code">404</div>
			<p class="error-message">{{msg.error_notfound_message}}</p>

			<div class="error-actions">
				<a href="/" class="error-button primary">{{msg.error_button_home}}</a>
				<a href="javascript:history.back()" class="error-button secondary">{{msg.error_button_back}}</a>
			</div>

			<div class="error-note">
				<p>{{msg.error_notfound_note}}</p>
			</div>
		</div>
	</div>
</main>

{{> footer}}
