<!-- No stopPropagation on the dialog: the scene-select handlers are delegated to
     document, and closeShareDialog already ignores bubbled clicks from inside. -->
<div class="dialog-overlay" id="share-dialog-overlay" onclick="closeShareDialog(event)">
	<div class="dialog dialog--sheet">
		<div class="dialog__header">
			<h3>{{msg.story_share_private_title}}</h3>
			<button type="button" class="dialog__close" onclick="closeShareDialog()">
				<i class="fas fa-times"></i>
			</button>
		</div>
		<!-- The server closes this dialog via OOB swap only on success, so a
		     rejected create keeps the form and its scene selection on screen. -->
		<form data-scene-select
			  hx-post="/story/{{projectNameForUrl}}/access"
			  hx-target="#publish-section"
			  hx-swap="outerHTML">
			<div class="dialog__body">
				<div class="form-field">
					<label for="access-password" class="form-field__label">{{msg.story_access_password}}</label>
					<input type="text"
						   id="access-password"
						   name="password"
						   class="form-input"
						   required
						   minlength="1"
						   autocomplete="off"
						   placeholder="{{msg.story_access_password_placeholder}}">
				</div>
				<div class="form-field">
					<label for="access-expires" class="form-field__label">
						{{msg.story_access_expires}}
						<span class="optional-label">({{msg.story_access_optional}})</span>
					</label>
					<input type="date"
						   id="access-expires"
						   name="expiresAt"
						   class="form-input"
						   min="{{minDate}}">
				</div>
				<div class="form-field">
					<!-- The checkbox reuses the scene-row classes for its look, but sits outside
					     .review-form__scene-tree so it never counts as a selected scene. -->
					<label class="share-form__limit">
						<input type="checkbox" name="limitScenes" class="review-scene-row__check">
						<span class="review-scene-row__box"><i class="fa-solid fa-check"></i></span>
						<span class="review-scene-row__name share-form__limit-name">
							{{msg.story_share_limit_scenes}}
							<span class="optional-label">{{msg.story_share_limit_scenes_hint}}</span>
						</span>
					</label>
					<div class="share-form__scenes" hidden>
						<div class="review-form__scenes-head">
							<span class="form-field__label">{{msg.story_share_scenes}}</span>
							<span class="review-form__scene-count"
								  data-total="{{sceneCount}}"
								  data-none-label="{{msg.review_dialog_scenes_none}}">{{msg.review_dialog_scenes_none}}</span>
						</div>
						{{> scene-select-tree}}
					</div>
				</div>
			</div>
			<div class="dialog__actions">
				<button type="button" class="btn btn--ghost" onclick="closeShareDialog()">
					{{msg.story_cancel}}
				</button>
				<button type="submit" class="btn btn--accent" data-scene-submit>
					{{msg.story_create_access}}
				</button>
			</div>
		</form>
	</div>
</div>
