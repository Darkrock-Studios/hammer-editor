<span class="reader-tools__group">
	<button type="button" class="reader-tool" data-reader-action="smaller"
			aria-label="{{msg.story_read_font_smaller}}" title="{{msg.story_read_font_smaller}}">A&minus;</button>
	<button type="button" class="reader-tool reader-tool--value" data-reader-action="reset-size"
			aria-label="{{msg.story_read_font_reset}}" title="{{msg.story_read_font_reset}}"
			data-reader-size-label>18</button>
	<button type="button" class="reader-tool" data-reader-action="larger"
			aria-label="{{msg.story_read_font_larger}}" title="{{msg.story_read_font_larger}}">A+</button>
</span>
