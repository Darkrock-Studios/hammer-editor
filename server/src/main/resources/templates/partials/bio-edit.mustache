<!-- Edit State: Textarea editor -->
<div class="bio-edit hidden" id="bio-edit-state">
	<form class="bio-form"
		  hx-post="/dashboard/bio"
		  hx-target="#bio-section"
		  hx-swap="innerHTML">
		<div class="bio-input-wrapper">
			<label for="bio-input" class="bio-edit-label">{{msg.bio_edit_label}}</label>
			<div class="bio-input-container">
				<textarea id="bio-input"
						  name="bio"
						  rows="8"
						  maxlength="1024"
						  placeholder="{{msg.bio_edit_placeholder}}"
						  data-on-input="bio-input">{{bio}}</textarea>
				<span class="char-count" id="bio-char-count">0/1024</span>
			</div>
			<p class="bio-help-text">{{msg.bio_markdown_help}}</p>
		</div>
		<div class="bio-actions">
			<button type="submit" class="save-bio-btn">
				<i class="fa-solid fa-check"></i>
				{{msg.bio_save_button}}
			</button>
			<button type="button" class="cancel-btn" data-on-click="bio-edit-cancel">
				{{msg.bio_cancel_button}}
			</button>
		</div>
	</form>
</div>
