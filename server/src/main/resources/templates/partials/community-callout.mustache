{{#communityEnabled}}
	<!-- Community Callout -->
	<div class="community-callout">
		<a href="/community/feed" class="community-callout__inner">
			<div class="community-callout__icon">
				<i class="fa-solid fa-book-open-reader"></i>
			</div>
			<div class="community-callout__content">
				<h3 class="community-callout__title">{{msg.community_callout_title}}</h3>
				<p class="community-callout__text">
					{{#hasCommunityContent}}
						<strong>{{communityAuthorCount}}</strong> {{msg.community_callout_authors}} {{msg.community_callout_sharing}}
						<strong>{{communityStoryCount}}</strong> {{msg.community_callout_stories}}
					{{/hasCommunityContent}}
					{{#hasCommunityAuthorsOnly}}
						{{msg.community_callout_authors_only}}
					{{/hasCommunityAuthorsOnly}}
					{{#hasNoCommunityContent}}
						{{msg.community_callout_empty}}
					{{/hasNoCommunityContent}}
				</p>
			</div>
			<span class="community-callout__arrow">
			<i class="fa-solid fa-arrow-right"></i>
		</span>
		</a>
	</div>
{{/communityEnabled}}
