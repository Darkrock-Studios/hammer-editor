<details class="mon-error mon-error--{{severity}}{{^canIgnore}} mon-error--ignored{{/canIgnore}}">
	<summary class="mon-error__summary">
		<span class="mon-error__count">{{count}}&times;</span>
		<i class="mon-error__icon fa-solid {{severityIcon}}"
		   aria-hidden="true"></i>
		<span class="mon-error__status">{{status}}</span>
		<span class="mon-error__type">{{type}}</span>
		<span class="mon-error__route">{{route}}</span>
		<span class="mon-error__meta">
			{{#hasUser}}<span class="mon-error__user"><i
				class="fa-solid fa-user"></i> {{user}}</span>{{/hasUser}}
			<span class="mon-error__seen">{{lastSeen}}</span>
		</span>
	</summary>
	<div class="mon-error__body">
		{{#hasMessage}}<p class="mon-error__message">{{message}}</p>{{/hasMessage}}
		{{#hasStack}}
			<pre class="mon-error__stack">{{stackTrace}}</pre>{{/hasStack}}
		{{#canIgnore}}
			<form class="mon-error__actions" hx-post="/admin/monitoring/errors/ignore"
			      hx-swap="none">
				<input type="hidden" name="type" value="{{type}}">
				<button type="submit" class="btn btn--ghost mon-error__ignore-btn">
					<i class="fa-solid fa-eye-slash"></i> {{msg.admin_mon_errors_ignore_type}}
				</button>
				{{#hasRoute}}
					<button type="submit" class="btn btn--ghost mon-error__ignore-btn"
					        name="routeGlob" value="{{routeRaw}}">
						<i class="fa-solid fa-eye-slash"></i> {{msg.admin_mon_errors_ignore_route}}
					</button>
				{{/hasRoute}}
			</form>
		{{/canIgnore}}
	</div>
</details>
