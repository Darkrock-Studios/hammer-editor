{{> header}}

<main class="page">
	<div class="admin-layout">
		{{> partials/admin-nav}}

		<div class="admin-content">
			<!-- Admin Header -->
			<div class="page-header">
				<div class="page-header__content">
					<h1 class="page-header__title">{{msg.admin_whitelist_management_title}}</h1>
					<p class="page-header__subtitle">
						{{#whitelist.enabled}}
							{{msg.admin_whitelist_enabled_subtitle}}
						{{/whitelist.enabled}}
						{{^whitelist.enabled}}
							{{msg.admin_whitelist_disabled_subtitle}}
						{{/whitelist.enabled}}
					</p>
				</div>
				<div class="page-header__actions">
					<form action="/admin/whitelist/toggle" method="post" class="logout-form"
						  hx-post="/admin/whitelist/toggle"
						  hx-swap="none">
						<button type="submit" class="toggle-button {{#whitelist.enabled}}active{{/whitelist.enabled}}">
							{{#whitelist.enabled}}Disable Whitelist{{/whitelist.enabled}}
							{{^whitelist.enabled}}Enable Whitelist{{/whitelist.enabled}}
						</button>
					</form>
					{{#whitelist.enabled}}
						<span class="section-badge accent">{{msg.admin_badge_active}}</span>
					{{/whitelist.enabled}}
				</div>
			</div>

			<!-- Whitelist Management Section -->
			<section class="paper-section">
				<div class="section-header">
					<h2 class="section-header__title">{{msg.admin_whitelist_add_title}}</h2>
				</div>
				<p class="section-description">{{msg.admin_whitelist_description}}</p>

				<form action="/admin/whitelist/add" method="post" class="whitelist-form"
					  hx-post="/admin/whitelist/add"
					  hx-target="#whitelist"
					  hx-swap="innerHTML"
					  hx-on::after-request="this.reset()">
					<div class="form-group">
						<label for="email" class="form-field__label">{{msg.admin_whitelist_email_label}}</label>
						<input id="email" name="email" type="email" class="form-input"
							   placeholder="{{msg.admin_whitelist_email_placeholder}}" required/>
					</div>
					<div class="form-group">
						<label for="reason" class="form-field__label">Reason (optional)</label>
						<input id="reason" name="reason" type="text" class="form-input"
							   placeholder="e.g., Beta tester, Friend of the project" maxlength="32"/>
					</div>
					<div class="form-group">
						<button type="submit"
								class="btn btn--accent btn--block">{{msg.admin_whitelist_add_button}}</button>
					</div>
				</form>

				<div class="whitelist-container">
					<div id="whitelist"
						 hx-get="/admin/whitelist/user-fragment"
						 hx-trigger="load, whitelist-updated from:body"
						 hx-swap="innerHTML">
						<!-- List of whitelisted users loaded here -->
					</div>
				</div>
			</section>
		</div>
	</div>
</main>

<!-- Edit Reason Dialog -->
<div class="dialog-overlay hidden" id="edit-reason-dialog">
	<div class="dialog">
		<div class="dialog__header">
			<h3>{{msg.admin_whitelist_edit_reason_title}}</h3>
			<button class="dialog__close" onclick="closeEditReasonDialog()">
				<i class="fas fa-times"></i>
			</button>
		</div>
		<form action="/admin/whitelist/edit-reason" method="post"
			  hx-post="/admin/whitelist/edit-reason"
			  hx-target="#whitelist"
			  hx-swap="innerHTML"
			  hx-on::after-request="closeEditReasonDialog()">
			<div class="dialog__body">
				<p class="dialog__email-display" id="edit-dialog-email-display"></p>
				<input type="hidden" name="email" id="edit-reason-email"/>
				<input type="hidden" name="page" id="edit-reason-page"/>
				<div class="form-field">
					<label for="edit-reason-input"
						   class="form-field__label">{{msg.admin_whitelist_reason_label}}</label>
					<input type="text" id="edit-reason-input" name="reason" class="form-input"
						   placeholder="{{msg.admin_whitelist_reason_placeholder}}" maxlength="32"/>
					<p class="form-field__help">{{msg.admin_whitelist_reason_help}}</p>
				</div>
			</div>
			<div class="dialog__actions">
				<button type="button" class="btn btn--ghost"
						onclick="closeEditReasonDialog()">{{msg.admin_dialog_cancel}}</button>
				<button type="submit" class="btn btn--accent">{{msg.admin_whitelist_save_reason}}</button>
			</div>
		</form>
	</div>
</div>

<script>
	function openEditReasonDialog(btn) {
		const email = btn.dataset.email;
		const reason = btn.dataset.reason;
		const page = btn.dataset.page;

		document.getElementById('edit-dialog-email-display').textContent = email;
		document.getElementById('edit-reason-email').value = email;
		document.getElementById('edit-reason-input').value = reason;
		document.getElementById('edit-reason-page').value = page;

		const dialog = document.getElementById('edit-reason-dialog');
		dialog.classList.remove('hidden', 'closing');

		// Focus the input after a brief delay to allow for animation
		setTimeout(() => {
			document.getElementById('edit-reason-input').focus();
			document.getElementById('edit-reason-input').select();
		}, 100);
	}

	function closeEditReasonDialog() {
		const dialog = document.getElementById('edit-reason-dialog');
		dialog.classList.add('closing');
		setTimeout(() => {
			dialog.classList.add('hidden');
			dialog.classList.remove('closing');
		}, 200);
	}

	// Close dialog on escape key
	document.addEventListener('keydown', function (e) {
		if (e.key === 'Escape') {
			const dialog = document.getElementById('edit-reason-dialog');
			if (!dialog.classList.contains('hidden')) {
				closeEditReasonDialog();
			}
		}
	});

	// Close dialog when clicking outside
	document.getElementById('edit-reason-dialog').addEventListener('click', function (e) {
		if (e.target === this) {
			closeEditReasonDialog();
		}
	});
</script>

<div id="result"></div>
{{> footer}}
