{{> header}}

<main class="page">
	<div class="admin-layout">
		{{> partials/admin-nav}}

		<div class="admin-content">
			<!-- Admin Header -->
			<div class="page-header">
				<div class="page-header__content">
					<h1 class="page-header__title">{{msg.admin_whitelist_management_title}}</h1>
					<p class="page-header__subtitle">
						{{#whitelist.enabled}}
							{{msg.admin_whitelist_enabled_subtitle}}
						{{/whitelist.enabled}}
						{{^whitelist.enabled}}
							{{msg.admin_whitelist_disabled_subtitle}}
						{{/whitelist.enabled}}
					</p>
				</div>
				<div class="page-header__actions">
					<form action="/admin/whitelist/toggle" method="post" class="logout-form"
						  hx-post="/admin/whitelist/toggle"
						  hx-swap="none">
						{{#whitelist.enabled}}
							{{#whitelist.canDisable}}
								<button type="submit" class="toggle-button active">
									Disable Whitelist
								</button>
							{{/whitelist.canDisable}}
							{{^whitelist.canDisable}}
								<button type="button" class="toggle-button active" disabled
										title="{{msg.admin_whitelist_cannot_disable_patreon}}">
									Disable Whitelist
								</button>
							{{/whitelist.canDisable}}
						{{/whitelist.enabled}}
						{{^whitelist.enabled}}
							<button type="submit" class="toggle-button">
								Enable Whitelist
							</button>
						{{/whitelist.enabled}}
					</form>
					{{#whitelist.enabled}}
						<span class="section-badge accent">{{msg.admin_badge_active}}</span>
					{{/whitelist.enabled}}
				</div>
			</div>

			<!-- Whitelist Management Section -->
			<section class="paper-section">
				<div class="section-header">
					<h2 class="section-header__title">{{msg.admin_whitelist_add_title}}</h2>
				</div>
				<p class="section-description">{{msg.admin_whitelist_description}}</p>

				<form action="/admin/whitelist/add" method="post" class="whitelist-form" id="add-whitelist-form"
					  hx-post="/admin/whitelist/add"
					  hx-target="#whitelist"
					  hx-swap="innerHTML">
					<input type="hidden" name="page" id="add-form-page" value="0"/>
					<input type="hidden" name="sortOldestFirst" id="add-form-sort" value="false"/>
					<div class="form-group">
						<label for="email" class="form-field__label">{{msg.admin_whitelist_email_label}}</label>
						<input id="email" name="email" type="email" class="form-input"
							   placeholder="{{msg.admin_whitelist_email_placeholder}}" required/>
					</div>
					<div class="form-group">
						<label for="reason" class="form-field__label">Reason (optional)</label>
						<input id="reason" name="reason" type="text" class="form-input"
							   placeholder="e.g., Beta tester, Friend of the project" maxlength="32"/>
					</div>
					<div class="form-group">
						<label for="add-expiry-preset"
							   class="form-field__label">{{msg.admin_whitelist_expiry_label}}</label>
						<select id="add-expiry-preset" name="expiryPreset" class="form-select"
								data-on-change="expiry-preset" data-expiry-field="add-expiry-date-field">
							<option value="never" selected>{{msg.admin_whitelist_expiry_never}}</option>
							<option value="7">{{msg.admin_whitelist_expiry_7days}}</option>
							<option value="30">{{msg.admin_whitelist_expiry_30days}}</option>
							<option value="90">{{msg.admin_whitelist_expiry_90days}}</option>
							<option value="custom">{{msg.admin_whitelist_expiry_custom}}</option>
						</select>
						<p class="form-field__help">{{msg.admin_whitelist_expiry_help}}</p>
					</div>
					<div class="form-group hidden" id="add-expiry-date-field">
						<label for="add-expiry-date"
							   class="form-field__label form-field__label--small">{{msg.admin_whitelist_expiry_date_label}}</label>
						<input id="add-expiry-date" name="expiryDate" type="date" class="form-input"/>
					</div>
					<div class="form-group">
						<button type="submit"
								class="btn btn--accent btn--block">{{msg.admin_whitelist_add_button}}</button>
					</div>
				</form>

				<div class="whitelist-container">
					<div id="whitelist"
						 hx-get="/admin/whitelist/user-fragment"
						 hx-trigger="load, whitelist-updated from:body"
						 hx-swap="innerHTML">
						<!-- List of whitelisted users loaded here -->
					</div>
				</div>
			</section>
		</div>
	</div>
</main>

<!-- Edit Reason Dialog -->
<div class="dialog-overlay hidden" id="edit-reason-dialog" data-on-click="dialog-dismiss">
	<div class="dialog">
		<div class="dialog__header">
			<h3>{{msg.admin_whitelist_edit_reason_title}}</h3>
			<button class="dialog__close" data-on-click="edit-reason-close">
				<i class="fas fa-times"></i>
			</button>
		</div>
		<form action="/admin/whitelist/edit-reason" method="post"
			  hx-post="/admin/whitelist/edit-reason"
			  hx-target="#whitelist"
			  hx-swap="innerHTML">
			<div class="dialog__body">
				<p class="dialog__email-display" id="edit-dialog-email-display"></p>
				<input type="hidden" name="email" id="edit-reason-email"/>
				<input type="hidden" name="page" id="edit-reason-page"/>
				<input type="hidden" name="sortOldestFirst" id="edit-reason-sort"/>
				<div class="form-field">
					<label for="edit-reason-input"
						   class="form-field__label">{{msg.admin_whitelist_reason_label}}</label>
					<input type="text" id="edit-reason-input" name="reason" class="form-input"
						   placeholder="{{msg.admin_whitelist_reason_placeholder}}" maxlength="32"/>
					<p class="form-field__help">{{msg.admin_whitelist_reason_help}}</p>
				</div>
			</div>
			<div class="dialog__actions">
				<button type="button" class="btn btn--ghost"
						data-on-click="edit-reason-close">{{msg.admin_dialog_cancel}}</button>
				<button type="submit" class="btn btn--accent">{{msg.admin_whitelist_save_reason}}</button>
			</div>
		</form>
	</div>
</div>

<!-- Edit Expiry Dialog -->
<div class="dialog-overlay hidden" id="edit-expiry-dialog" data-on-click="dialog-dismiss">
	<div class="dialog">
		<div class="dialog__header">
			<h3>{{msg.admin_whitelist_edit_expiry_title}}</h3>
			<button class="dialog__close" data-on-click="edit-expiry-close">
				<i class="fas fa-times"></i>
			</button>
		</div>
		<form action="/admin/whitelist/edit-expiry" method="post"
			  hx-post="/admin/whitelist/edit-expiry"
			  hx-target="#whitelist"
			  hx-swap="innerHTML">
			<div class="dialog__body">
				<p class="dialog__email-display" id="edit-expiry-email-display"></p>
				<p class="whitelist-expiry__current">
						{{msg.admin_whitelist_expiry_current}}
						<span class="whitelist-expiry__current-value" id="edit-expiry-current"></span>
					</p>
					<input type="hidden" name="email" id="edit-expiry-email"/>
				<input type="hidden" name="page" id="edit-expiry-page"/>
				<input type="hidden" name="sortOldestFirst" id="edit-expiry-sort"/>
				<div class="form-field">
					<label for="edit-expiry-preset"
						   class="form-field__label">{{msg.admin_whitelist_expiry_change_label}}</label>
					<select id="edit-expiry-preset" name="expiryPreset" class="form-select"
							data-on-change="expiry-preset" data-expiry-field="edit-expiry-date-field">
						<option value="never">{{msg.admin_whitelist_expiry_never}}</option>
						<option value="7">{{msg.admin_whitelist_expiry_extend_7days}}</option>
						<option value="30">{{msg.admin_whitelist_expiry_extend_30days}}</option>
						<option value="90">{{msg.admin_whitelist_expiry_extend_90days}}</option>
						<option value="custom">{{msg.admin_whitelist_expiry_custom}}</option>
					</select>
					<p class="form-field__help">{{msg.admin_whitelist_expiry_help}}</p>
				</div>
				<div class="form-field hidden" id="edit-expiry-date-field">
					<label for="edit-expiry-date"
						   class="form-field__label form-field__label--small">{{msg.admin_whitelist_expiry_date_label}}</label>
					<input type="date" id="edit-expiry-date" name="expiryDate" class="form-input"/>
				</div>
			</div>
			<div class="dialog__actions">
				<button type="button" class="btn btn--ghost"
						data-on-click="edit-expiry-close">{{msg.admin_dialog_cancel}}</button>
				<button type="submit" class="btn btn--accent">{{msg.admin_whitelist_save_expiry}}</button>
			</div>
		</form>
	</div>
</div>

<script defer src="/assets/js/admin-whitelist.js?v={{version}}"></script>

<div id="result"></div>
{{> footer}}
