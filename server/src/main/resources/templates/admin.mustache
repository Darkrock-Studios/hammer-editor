{{> header}}

<main class="admin-page">
	<div class="admin-container">
		<!-- Admin Header -->
		<div class="admin-header">
			<div class="admin-header-content">
				<h1>{{msg.admin_dashboard_title}}</h1>
				<p class="admin-subtitle">{{msg.admin_dashboard_subtitle}}</p>
			</div>
			<form action="/logout" method="get" class="logout-form">
				<button type="submit" class="logout-button">{{msg.admin_logout_button}}</button>
			</form>
		</div>

		<!-- Server Settings Section -->
		<section class="admin-section">
			<div class="section-header">
				<div class="section-title-group">
					<h2>{{msg.admin_serversettings_title}}</h2>
				</div>
			</div>
			<p class="section-description">{{msg.admin_serversettings_description}}</p>

			<form action="/admin/settings" method="post" class="settings-form"
				  hx-post="/admin/settings"
				  hx-swap="none">
				<div class="form-group">
					<label for="contact">{{msg.admin_serversettings_contact_label}}</label>
					<div class="form-input-group">
						<input id="contact" name="contact" type="email" value="{{contactEmail}}"
							   placeholder="{{msg.admin_serversettings_contact_placeholder}}"/>
					</div>
				</div>

				<div class="form-group">
					<label for="defaultLocale">{{msg.admin_serversettings_default_locale_label}}</label>
					<div class="form-input-group">
						<select id="defaultLocale" name="defaultLocale" class="settings-select">
							{{#availableLocales}}
								<option value="{{tag}}" {{#selected}}selected{{/selected}}>{{label}}</option>
							{{/availableLocales}}
						</select>
					</div>
				</div>

				<div class="form-group">
					<label for="message">{{msg.admin_serversettings_message_label}}</label>
					<div class="form-input-group">
						<textarea id="message" name="message" rows="4"
								  class="settings-textarea">{{serverMessage}}</textarea>
					</div>
				</div>

				<div class="form-actions">
					<button type="submit" class="save-button">{{msg.admin_serversettings_save_button}}</button>
				</div>
			</form>
		</section>

		<!-- Whitelist Management Section -->
		<section class="admin-section">
			<div class="section-header">
				<div class="section-title-group">
					<h2>{{msg.admin_whitelist_management_title}}</h2>
					<p class="admin-subtitle">
						{{#whitelist.enabled}}
							{{msg.admin_whitelist_enabled_subtitle}}
						{{/whitelist.enabled}}
						{{^whitelist.enabled}}
							{{msg.admin_whitelist_disabled_subtitle}}
						{{/whitelist.enabled}}
					</p>
				</div>
				<div class="section-header-actions">
					<form action="/admin/whitelist/toggle" method="post" class="logout-form"
						  hx-post="/admin/whitelist/toggle"
						  hx-swap="none">
						<button type="submit" class="toggle-button {{#whitelist.enabled}}active{{/whitelist.enabled}}">
							{{#whitelist.enabled}}Disable Whitelist{{/whitelist.enabled}}
							{{^whitelist.enabled}}Enable Whitelist{{/whitelist.enabled}}
						</button>
					</form>
					{{#whitelist.enabled}}
						<span class="section-badge accent">{{msg.admin_badge_active}}</span>
					{{/whitelist.enabled}}
				</div>
			</div>
			<p class="section-description">{{msg.admin_whitelist_description}}</p>

			<form action="/admin/whitelist/add" method="post" class="whitelist-form"
				  hx-post="/admin/whitelist/add"
				  hx-target="#whitelist"
				  hx-swap="innerHTML"
				  hx-on::after-request="this.reset()">
				<div class="form-group">
					<label for="email">{{msg.admin_whitelist_email_label}}</label>
					<div class="form-input-group">
						<input id="email" name="email" type="email"
							   placeholder="{{msg.admin_whitelist_email_placeholder}}" required/>
						<button type="submit" class="add-button">{{msg.admin_whitelist_add_button}}</button>
					</div>
				</div>
			</form>

			<div class="whitelist-container">
				<div id="whitelist"
					 hx-get="/admin/whitelist/user-fragment"
					 hx-trigger="load, whitelist-updated from:body"
					 hx-swap="innerHTML">
					<!-- List of whitelisted users loaded here -->
				</div>
			</div>
		</section>
	</div>
</main>

<div id="result"></div>
{{> footer}}
