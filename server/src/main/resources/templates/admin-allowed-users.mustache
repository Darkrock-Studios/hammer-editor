{{> header}}

<main class="page">
	<div class="admin-layout">
		{{> partials/admin-nav}}

		<div class="admin-content">
			<!-- Admin Header -->
			<div class="page-header">
				<div class="page-header__content">
					<h1 class="page-header__title">{{msg.admin_allowedusers_management_title}}</h1>
					<p class="page-header__subtitle">{{msg.admin_allowedusers_subtitle}}</p>
				</div>
			</div>

			<!-- Allowed Users Management Section -->
			<section class="paper-section">
				<div class="section-header">
					<h2 class="section-header__title">{{msg.admin_allowedusers_add_title}}</h2>
				</div>
				<p class="section-description">{{msg.admin_allowedusers_description}}</p>

				<form action="/admin/allowed-users/add" method="post" class="whitelist-form" id="add-whitelist-form"
					  hx-post="/admin/allowed-users/add"
					  hx-target="#whitelist"
					  hx-swap="innerHTML"
					  hx-include="#whitelist-search, #whitelist-sort-state, #whitelist-page-state">
					<div class="form-group">
						<label for="email" class="form-field__label">{{msg.admin_allowedusers_email_label}}</label>
						<input id="email" name="email" type="email" class="form-input"
							   placeholder="{{msg.admin_allowedusers_email_placeholder}}" required/>
					</div>
					<div class="form-group">
						<label for="reason" class="form-field__label">Reason (optional)</label>
						<input id="reason" name="reason" type="text" class="form-input"
							   placeholder="e.g., Beta tester, Friend of the project" maxlength="32"/>
					</div>
					<div class="form-group">
						<label for="add-expiry-preset"
							   class="form-field__label">{{msg.admin_allowedusers_expiry_label}}</label>
						<select id="add-expiry-preset" name="expiryPreset" class="form-select"
								data-on-change="toggleExpiryDate(this, 'add-expiry-date-field')">
							<option value="never" selected>{{msg.admin_allowedusers_expiry_never}}</option>
							<option value="7">{{msg.admin_allowedusers_expiry_7days}}</option>
							<option value="30">{{msg.admin_allowedusers_expiry_30days}}</option>
							<option value="90">{{msg.admin_allowedusers_expiry_90days}}</option>
							<option value="custom">{{msg.admin_allowedusers_expiry_custom}}</option>
						</select>
						<p class="form-field__help">{{msg.admin_allowedusers_expiry_help}}</p>
					</div>
					<div class="form-group hidden" id="add-expiry-date-field">
						<label for="add-expiry-date"
							   class="form-field__label form-field__label--small">{{msg.admin_allowedusers_expiry_date_label}}</label>
						<input id="add-expiry-date" name="expiryDate" type="date" class="form-input"/>
					</div>
					<div class="form-group">
						<button type="submit"
								class="btn btn--accent btn--block">{{msg.admin_allowedusers_add_button}}</button>
					</div>
				</form>

				<div class="whitelist-container">
					<div class="whitelist-search">
						<div class="form-field whitelist-search__field">
							<label class="form-field__label form-field__label--small"
								   for="whitelist-search">{{msg.admin_allowedusers_search_label}}</label>
							<input id="whitelist-search" name="q" type="search" class="form-input"
								   autocomplete="off"
								   placeholder="{{msg.admin_allowedusers_search_placeholder}}"
								   hx-get="/admin/allowed-users/user-fragment"
								   hx-target="#whitelist"
								   hx-swap="innerHTML"
								   hx-include="#whitelist-sort-state"
								   hx-trigger="input changed delay:300ms, search"/>
						</div>
					</div>

					<div id="whitelist"
						 hx-get="/admin/allowed-users/user-fragment"
						 hx-trigger="load"
						 hx-swap="innerHTML">
						<!-- List of allowed users loaded here -->
					</div>
				</div>
			</section>
		</div>
	</div>
</main>

<!-- Edit Reason Dialog -->
<div class="dialog-overlay hidden" id="edit-reason-dialog">
	<div class="dialog">
		<div class="dialog__header">
			<h3>{{msg.admin_allowedusers_edit_reason_title}}</h3>
			<button class="dialog__close" data-on-click="closeEditReasonDialog()">
				<i class="fas fa-times"></i>
			</button>
		</div>
		<form action="/admin/allowed-users/edit-reason" method="post" id="edit-reason-form"
			  hx-post="/admin/allowed-users/edit-reason"
			  hx-target="#whitelist"
			  hx-swap="innerHTML">
			<div class="dialog__body">
				<p class="dialog__email-display" id="edit-dialog-email-display"></p>
				<input type="hidden" name="email" id="edit-reason-email"/>
				<input type="hidden" name="page" id="edit-reason-page"/>
				<input type="hidden" name="sortOldestFirst" id="edit-reason-sort"/>
				<input type="hidden" name="q" id="edit-reason-q"/>
				<div class="form-field">
					<label for="edit-reason-input"
						   class="form-field__label">{{msg.admin_allowedusers_reason_label}}</label>
					<input type="text" id="edit-reason-input" name="reason" class="form-input"
						   placeholder="{{msg.admin_allowedusers_reason_placeholder}}" maxlength="32"/>
					<p class="form-field__help">{{msg.admin_allowedusers_reason_help}}</p>
				</div>
			</div>
			<div class="dialog__actions">
				<button type="button" class="btn btn--ghost"
						data-on-click="closeEditReasonDialog()">{{msg.admin_dialog_cancel}}</button>
				<button type="submit" class="btn btn--accent">{{msg.admin_allowedusers_save_reason}}</button>
			</div>
		</form>
	</div>
</div>

<!-- Edit Expiry Dialog -->
<div class="dialog-overlay hidden" id="edit-expiry-dialog">
	<div class="dialog">
		<div class="dialog__header">
			<h3>{{msg.admin_allowedusers_edit_expiry_title}}</h3>
			<button class="dialog__close" data-on-click="closeEditExpiryDialog()">
				<i class="fas fa-times"></i>
			</button>
		</div>
		<form action="/admin/allowed-users/edit-expiry" method="post" id="edit-expiry-form"
			  hx-post="/admin/allowed-users/edit-expiry"
			  hx-target="#whitelist"
			  hx-swap="innerHTML">
			<div class="dialog__body">
				<p class="dialog__email-display" id="edit-expiry-email-display"></p>
				<p class="whitelist-expiry__current">
						{{msg.admin_allowedusers_expiry_current}}
						<span class="whitelist-expiry__current-value" id="edit-expiry-current"></span>
					</p>
					<input type="hidden" name="email" id="edit-expiry-email"/>
				<input type="hidden" name="page" id="edit-expiry-page"/>
				<input type="hidden" name="sortOldestFirst" id="edit-expiry-sort"/>
				<input type="hidden" name="q" id="edit-expiry-q"/>
				<div class="form-field">
					<label for="edit-expiry-preset"
						   class="form-field__label">{{msg.admin_allowedusers_expiry_change_label}}</label>
					<select id="edit-expiry-preset" name="expiryPreset" class="form-select"
							data-on-change="toggleExpiryDate(this, 'edit-expiry-date-field')">
						<option value="never">{{msg.admin_allowedusers_expiry_never}}</option>
						<option value="7">{{msg.admin_allowedusers_expiry_extend_7days}}</option>
						<option value="30">{{msg.admin_allowedusers_expiry_extend_30days}}</option>
						<option value="90">{{msg.admin_allowedusers_expiry_extend_90days}}</option>
						<option value="custom">{{msg.admin_allowedusers_expiry_custom}}</option>
					</select>
					<p class="form-field__help">{{msg.admin_allowedusers_expiry_help}}</p>
				</div>
				<div class="form-field hidden" id="edit-expiry-date-field">
					<label for="edit-expiry-date"
						   class="form-field__label form-field__label--small">{{msg.admin_allowedusers_expiry_date_label}}</label>
					<input type="date" id="edit-expiry-date" name="expiryDate" class="form-input"/>
				</div>
			</div>
			<div class="dialog__actions">
				<button type="button" class="btn btn--ghost"
						data-on-click="closeEditExpiryDialog()">{{msg.admin_dialog_cancel}}</button>
				<button type="submit" class="btn btn--accent">{{msg.admin_allowedusers_save_expiry}}</button>
			</div>
		</form>
	</div>
</div>

<script src="/assets/js/admin-allowed-users.js?v={{version}}"></script>

<div id="result"></div>
{{> footer}}
