{{> header}}

<main class="page">
	<div class="admin-layout">
		{{> partials/admin-nav}}

		<div class="admin-content">
			<!-- Admin Header -->
			<div class="page-header">
				<div class="page-header__content">
					<h1 class="page-header__title">{{msg.admin_allowedusers_management_title}}</h1>
					<p class="page-header__subtitle">{{msg.admin_allowedusers_subtitle}}</p>
				</div>
			</div>

			<!-- Allowed Users Management Section -->
			<section class="paper-section">
				<div class="section-header">
					<h2 class="section-header__title">{{msg.admin_allowedusers_add_title}}</h2>
				</div>
				<p class="section-description">{{msg.admin_allowedusers_description}}</p>

				<form action="/admin/allowed-users/add" method="post" class="whitelist-form" id="add-whitelist-form"
					  hx-post="/admin/allowed-users/add"
					  hx-target="#whitelist"
					  hx-swap="innerHTML"
					  hx-on::after-request="this.reset(); syncAddExpiryDateVisibility()">
					<input type="hidden" name="page" id="add-form-page" value="0"/>
					<input type="hidden" name="sortOldestFirst" id="add-form-sort" value="false"/>
					<div class="form-group">
						<label for="email" class="form-field__label">{{msg.admin_allowedusers_email_label}}</label>
						<input id="email" name="email" type="email" class="form-input"
							   placeholder="{{msg.admin_allowedusers_email_placeholder}}" required/>
					</div>
					<div class="form-group">
						<label for="reason" class="form-field__label">Reason (optional)</label>
						<input id="reason" name="reason" type="text" class="form-input"
							   placeholder="e.g., Beta tester, Friend of the project" maxlength="32"/>
					</div>
					<div class="form-group">
						<label for="add-expiry-preset"
							   class="form-field__label">{{msg.admin_allowedusers_expiry_label}}</label>
						<select id="add-expiry-preset" name="expiryPreset" class="form-select"
								onchange="toggleExpiryDate(this, 'add-expiry-date-field')">
							<option value="never" selected>{{msg.admin_allowedusers_expiry_never}}</option>
							<option value="7">{{msg.admin_allowedusers_expiry_7days}}</option>
							<option value="30">{{msg.admin_allowedusers_expiry_30days}}</option>
							<option value="90">{{msg.admin_allowedusers_expiry_90days}}</option>
							<option value="custom">{{msg.admin_allowedusers_expiry_custom}}</option>
						</select>
						<p class="form-field__help">{{msg.admin_allowedusers_expiry_help}}</p>
					</div>
					<div class="form-group hidden" id="add-expiry-date-field">
						<label for="add-expiry-date"
							   class="form-field__label form-field__label--small">{{msg.admin_allowedusers_expiry_date_label}}</label>
						<input id="add-expiry-date" name="expiryDate" type="date" class="form-input"/>
					</div>
					<div class="form-group">
						<button type="submit"
								class="btn btn--accent btn--block">{{msg.admin_allowedusers_add_button}}</button>
					</div>
				</form>

				<div class="whitelist-container">
					<div id="whitelist"
						 hx-get="/admin/allowed-users/user-fragment"
						 hx-trigger="load, whitelist-updated from:body"
						 hx-swap="innerHTML">
						<!-- List of allowed users loaded here -->
					</div>
				</div>
			</section>
		</div>
	</div>
</main>

<!-- Edit Reason Dialog -->
<div class="dialog-overlay hidden" id="edit-reason-dialog">
	<div class="dialog">
		<div class="dialog__header">
			<h3>{{msg.admin_allowedusers_edit_reason_title}}</h3>
			<button class="dialog__close" onclick="closeEditReasonDialog()">
				<i class="fas fa-times"></i>
			</button>
		</div>
		<form action="/admin/allowed-users/edit-reason" method="post"
			  hx-post="/admin/allowed-users/edit-reason"
			  hx-target="#whitelist"
			  hx-swap="innerHTML"
			  hx-on::after-request="closeEditReasonDialog()">
			<div class="dialog__body">
				<p class="dialog__email-display" id="edit-dialog-email-display"></p>
				<input type="hidden" name="email" id="edit-reason-email"/>
				<input type="hidden" name="page" id="edit-reason-page"/>
				<input type="hidden" name="sortOldestFirst" id="edit-reason-sort"/>
				<div class="form-field">
					<label for="edit-reason-input"
						   class="form-field__label">{{msg.admin_allowedusers_reason_label}}</label>
					<input type="text" id="edit-reason-input" name="reason" class="form-input"
						   placeholder="{{msg.admin_allowedusers_reason_placeholder}}" maxlength="32"/>
					<p class="form-field__help">{{msg.admin_allowedusers_reason_help}}</p>
				</div>
			</div>
			<div class="dialog__actions">
				<button type="button" class="btn btn--ghost"
						onclick="closeEditReasonDialog()">{{msg.admin_dialog_cancel}}</button>
				<button type="submit" class="btn btn--accent">{{msg.admin_allowedusers_save_reason}}</button>
			</div>
		</form>
	</div>
</div>

<!-- Edit Expiry Dialog -->
<div class="dialog-overlay hidden" id="edit-expiry-dialog">
	<div class="dialog">
		<div class="dialog__header">
			<h3>{{msg.admin_allowedusers_edit_expiry_title}}</h3>
			<button class="dialog__close" onclick="closeEditExpiryDialog()">
				<i class="fas fa-times"></i>
			</button>
		</div>
		<form action="/admin/allowed-users/edit-expiry" method="post"
			  hx-post="/admin/allowed-users/edit-expiry"
			  hx-target="#whitelist"
			  hx-swap="innerHTML"
			  hx-on::after-request="closeEditExpiryDialog()">
			<div class="dialog__body">
				<p class="dialog__email-display" id="edit-expiry-email-display"></p>
				<p class="whitelist-expiry__current">
						{{msg.admin_allowedusers_expiry_current}}
						<span class="whitelist-expiry__current-value" id="edit-expiry-current"></span>
					</p>
					<input type="hidden" name="email" id="edit-expiry-email"/>
				<input type="hidden" name="page" id="edit-expiry-page"/>
				<input type="hidden" name="sortOldestFirst" id="edit-expiry-sort"/>
				<div class="form-field">
					<label for="edit-expiry-preset"
						   class="form-field__label">{{msg.admin_allowedusers_expiry_change_label}}</label>
					<select id="edit-expiry-preset" name="expiryPreset" class="form-select"
							onchange="toggleExpiryDate(this, 'edit-expiry-date-field')">
						<option value="never">{{msg.admin_allowedusers_expiry_never}}</option>
						<option value="7">{{msg.admin_allowedusers_expiry_extend_7days}}</option>
						<option value="30">{{msg.admin_allowedusers_expiry_extend_30days}}</option>
						<option value="90">{{msg.admin_allowedusers_expiry_extend_90days}}</option>
						<option value="custom">{{msg.admin_allowedusers_expiry_custom}}</option>
					</select>
					<p class="form-field__help">{{msg.admin_allowedusers_expiry_help}}</p>
				</div>
				<div class="form-field hidden" id="edit-expiry-date-field">
					<label for="edit-expiry-date"
						   class="form-field__label form-field__label--small">{{msg.admin_allowedusers_expiry_date_label}}</label>
					<input type="date" id="edit-expiry-date" name="expiryDate" class="form-input"/>
				</div>
			</div>
			<div class="dialog__actions">
				<button type="button" class="btn btn--ghost"
						onclick="closeEditExpiryDialog()">{{msg.admin_dialog_cancel}}</button>
				<button type="submit" class="btn btn--accent">{{msg.admin_allowedusers_save_expiry}}</button>
			</div>
		</form>
	</div>
</div>

<script>
	function toggleExpiryDate(select, fieldId) {
		const field = document.getElementById(fieldId);
		field.classList.toggle('hidden', select.value !== 'custom');
	}

	// form.reset() restores the select without firing onchange, so visibility is re-synced by hand.
	function syncAddExpiryDateVisibility() {
		toggleExpiryDate(document.getElementById('add-expiry-preset'), 'add-expiry-date-field');
	}

	function openEditExpiryDialog(btn) {
		const email = btn.dataset.email;
		const expiresRaw = btn.dataset.expiresRaw;

		document.getElementById('edit-expiry-email-display').textContent = email;
		document.getElementById('edit-expiry-current').textContent = btn.dataset.expires;
		document.getElementById('edit-expiry-email').value = email;
		document.getElementById('edit-expiry-page').value = btn.dataset.page;
		document.getElementById('edit-expiry-sort').value = btn.dataset.sortOldestFirst;

		// Default to a no-op: an entry with an expiry opens on "specific date" showing
		// its current value; an entry with no expiry opens on "Never".
		const preset = document.getElementById('edit-expiry-preset');
		preset.value = expiresRaw ? 'custom' : 'never';
		document.getElementById('edit-expiry-date').value = expiresRaw || '';
		toggleExpiryDate(preset, 'edit-expiry-date-field');

		const dialog = document.getElementById('edit-expiry-dialog');
		dialog.classList.remove('hidden', 'closing');

		setTimeout(() => preset.focus(), 100);
	}

	function closeEditExpiryDialog() {
		const dialog = document.getElementById('edit-expiry-dialog');
		dialog.classList.add('closing');
		setTimeout(() => {
			dialog.classList.add('hidden');
			dialog.classList.remove('closing');
		}, 200);
	}

	function openEditReasonDialog(btn) {
		const email = btn.dataset.email;
		const reason = btn.dataset.reason;
		const page = btn.dataset.page;
		const sortOldestFirst = btn.dataset.sortOldestFirst;

		document.getElementById('edit-dialog-email-display').textContent = email;
		document.getElementById('edit-reason-email').value = email;
		document.getElementById('edit-reason-input').value = reason;
		document.getElementById('edit-reason-page').value = page;
		document.getElementById('edit-reason-sort').value = sortOldestFirst;

		const dialog = document.getElementById('edit-reason-dialog');
		dialog.classList.remove('hidden', 'closing');

		// Focus the input after a brief delay to allow for animation
		setTimeout(() => {
			document.getElementById('edit-reason-input').focus();
			document.getElementById('edit-reason-input').select();
		}, 100);
	}

	function closeEditReasonDialog() {
		const dialog = document.getElementById('edit-reason-dialog');
		dialog.classList.add('closing');
		setTimeout(() => {
			dialog.classList.add('hidden');
			dialog.classList.remove('closing');
		}, 200);
	}

	// Update form hidden fields when whitelist is loaded/updated
	document.body.addEventListener('htmx:afterSwap', function (event) {
		if (event.detail.target.id === 'whitelist') {
			// Extract current page and sort from the loaded content
			const urlParams = new URLSearchParams(window.location.search);
			const currentPage = urlParams.get('page') || '0';
			const sortOldestFirst = urlParams.get('sortOldestFirst') || 'false';

			// Update add form hidden inputs
			document.getElementById('add-form-page').value = currentPage;
			document.getElementById('add-form-sort').value = sortOldestFirst;
		}
	});

	// Close dialog on escape key
	document.addEventListener('keydown', function (e) {
		if (e.key === 'Escape') {
			const dialog = document.getElementById('edit-reason-dialog');
			if (!dialog.classList.contains('hidden')) {
				closeEditReasonDialog();
			}
			const expiryDialog = document.getElementById('edit-expiry-dialog');
			if (!expiryDialog.classList.contains('hidden')) {
				closeEditExpiryDialog();
			}
		}
	});

	// Close dialog when clicking outside
	document.getElementById('edit-reason-dialog').addEventListener('click', function (e) {
		if (e.target === this) {
			closeEditReasonDialog();
		}
	});

	document.getElementById('edit-expiry-dialog').addEventListener('click', function (e) {
		if (e.target === this) {
			closeEditExpiryDialog();
		}
	});
</script>

<div id="result"></div>
{{> footer}}
