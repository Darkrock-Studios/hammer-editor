{{> header}}

<main class="page">
	<div class="admin-layout">
		{{> partials/admin-nav}}

		<div class="admin-content">
			<div class="page-header">
				<div class="page-header__content">
					<h1 class="page-header__title">{{msg.admin_grammar_title}}</h1>
					<p class="page-header__subtitle">{{msg.admin_grammar_subtitle}}</p>
				</div>
			</div>

			<section class="paper-section">
				<div class="section-header">
					<h2 class="section-header__title">{{msg.admin_grammar_status_title}}</h2>
				</div>

				<div class="status-info">
					<div class="status-item">
						<span class="status-label">{{msg.admin_grammar_status_label}}:</span>
						{{#grammarConfigured}}
							<span class="status-badge status-badge--active">{{msg.admin_grammar_status_on}}</span>
						{{/grammarConfigured}}
						{{^grammarConfigured}}
							<span class="status-badge status-badge--inactive">{{msg.admin_grammar_status_off}}</span>
						{{/grammarConfigured}}
					</div>
				</div>
				{{#grammarFromEnvironment}}
					<p class="section-description">{{msg.admin_grammar_from_environment}} <code>{{grammarEnvVar}}</code></p>
				{{/grammarFromEnvironment}}
				<p class="section-description">{{msg.admin_grammar_privacy}}</p>
			</section>

			<section class="paper-section">
				<div class="section-header">
					<h2 class="section-header__title">{{msg.admin_grammar_settings_title}}</h2>
				</div>
				<p class="section-description">{{msg.admin_grammar_settings_description}}</p>

				<form action="/admin/grammar/settings" method="post" class="settings-form"
					  hx-post="/admin/grammar/settings"
					  hx-swap="none">

					<div class="form-group">
						<label for="url" class="form-field__label">{{msg.admin_grammar_url}}</label>
						<p class="form-field__help">{{msg.admin_grammar_url_help}}</p>
						<div class="form-input-group">
							<input id="url" name="url" type="url" value="{{grammarUrl}}"
								   class="form-input"
								   placeholder="http://languagetool:8010"/>
							<button type="button" class="btn btn--primary"
									hx-post="/admin/grammar/test"
									hx-include="#url"
									hx-target="#grammar-test-result"
									hx-swap="innerHTML"
									hx-indicator="#grammar-test-indicator">
								<span class="button-text">{{msg.admin_grammar_test_button}}</span>
								<span id="grammar-test-indicator" class="htmx-indicator">
									<span class="spinner"></span>
								</span>
							</button>
						</div>
						<div id="grammar-test-result"></div>
					</div>

					<div class="form-group">
						<label for="requestsPerMinute" class="form-field__label">{{msg.admin_grammar_rate}}</label>
						<p class="form-field__help">{{msg.admin_grammar_rate_help}}</p>
						<div class="form-input-group">
							<input id="requestsPerMinute" name="requestsPerMinute" type="number"
								   min="1" max="{{grammarMaxRequestsPerMinute}}"
								   value="{{grammarRequestsPerMinute}}" class="form-input"/>
						</div>
					</div>

					<div class="form-group">
						<label for="maxRequestBytes" class="form-field__label">{{msg.admin_grammar_max_bytes}}</label>
						<p class="form-field__help">{{msg.admin_grammar_max_bytes_help}}</p>
						<div class="form-input-group">
							<input id="maxRequestBytes" name="maxRequestBytes" type="number"
								   min="{{grammarMinRequestBytes}}" max="{{grammarMaxRequestBytesCeiling}}"
								   value="{{grammarMaxRequestBytes}}" class="form-input"/>
						</div>
					</div>

					<div class="form-actions">
						<button type="submit" class="btn btn--accent">{{msg.admin_grammar_save_button}}</button>
					</div>
				</form>
			</section>
		</div>
	</div>
</main>

<div id="result"></div>
{{> footer}}
