{{> header}}

<main class="page">
	<div class="page__container">
		<!-- Dashboard Header -->
		<div class="page-header">
			<div class="page-header__content">
				<h1 class="page-header__title">{{msg.dashboard_title}}</h1>
				<p class="page-header__subtitle">{{msg.dashboard_subtitle}} {{username}}</p>
			</div>
			<div class="page-header__actions">
				{{#isAdmin}}
					<a href="/admin" class="manage-server-button">{{msg.dashboard_manage_server}}</a>
				{{/isAdmin}}
				<form action="/logout" method="get" class="logout-form">
					<button type="submit" class="logout-button">{{msg.admin_logout_button}}</button>
				</form>
			</div>
		</div>

		<!-- Projects Section -->
		<section class="paper-section">
			<div class="section-header">
				<h2 class="section-header__title">{{msg.dashboard_projects_title}}</h2>
			</div>
			<p class="section-description">{{msg.dashboard_projects_description}}</p>

			<div class="projects-container">
				<div id="projects-list-container">
					{{> partials/projects}}
				</div>
			</div>
		</section>

		<!-- Account Section -->
		<section class="paper-section">
			<div class="section-header">
				<h2 class="section-header__title">{{msg.dashboard_account_title}}</h2>
			</div>
			<div class="account-container">
				<div class="account-info">
					<p><strong>{{msg.dashboard_account_email}}:</strong> {{email}}</p>
					<p><strong>{{msg.dashboard_account_created}}:</strong> {{accountCreated}}</p>
					<div class="pen-name-section" id="pen-name-section"
						 data-has-penname="{{#penName}}true{{/penName}}{{^penName}}false{{/penName}}"
						 data-label="{{msg.penname_label}}">
						<p class="pen-name-header"><strong>{{msg.penname_label}}</strong></p>
						{{> penname-display}}
						{{> penname-edit}}
						{{> penname-release}}
					</div>
					<div class="bio-section" id="bio-section" {{^penName}}style="display:none;"{{/penName}}>
						{{> partials/bio-section}}
					</div>
					{{#communityEnabled}}
						<div class="community-section" id="community-section"
							 {{^penName}}style="display:none;"{{/penName}}>
							{{> partials/community-section}}
						</div>
					{{/communityEnabled}}
				</div>
			</div>

			<!-- Danger Zone (admin accounts cannot be deleted) -->
			{{^isAdmin}}
				<div class="account-danger-zone">
					<div class="danger-zone">
						<div class="danger-zone-header">
							<span class="danger-icon">&#9888;</span>
							<h3>{{msg.account_delete_title}}</h3>
						</div>
						<div class="danger-zone-content">
							<p class="danger-warning">{{msg.account_delete_warning}}</p>
						</div>
						<div class="danger-zone-actions">
							<button type="button"
									class="btn btn--danger"
									hx-get="/dashboard/delete-account-dialog"
									hx-target="#delete-account-dialog-container"
									hx-swap="innerHTML">
								{{msg.account_delete_button}}
							</button>
						</div>
					</div>
				</div>
				<div id="delete-account-dialog-container"></div>
			{{/isAdmin}}
			{{#isAdmin}}
				<p class="account-admin-delete-note">{{msg.account_delete_error_admin}}</p>
			{{/isAdmin}}
		</section>
	</div>
</main>

<script>
	// Localized messages for client-side JavaScript
	window.Messages = {
		penname: {
			checkingAvailability: '{{msg.penname_checking_availability}}',
			available: '{{msg.penname_validation_available}}',
			checkFailed: '{{msg.penname_check_failed}}',
			releaseConfirm: '{{msg.penname_release_confirm_message}}'
		},
		bio: {
			clearConfirm: '{{msg.bio_clear_confirm}}'
		}
	};
</script>

{{> footer}}
