{{> header}}

<main class="page">
	<div class="page__container">
		<!-- Dashboard Header -->
		<div class="page-header">
			<div class="page-header__content">
				<h1 class="page-header__title">{{msg.dashboard_title}}</h1>
				<p class="page-header__subtitle">{{msg.dashboard_subtitle}} {{username}}</p>
			</div>
			<div class="page-header__actions">
				{{#isAdmin}}
					<a href="/admin" class="manage-server-button">{{msg.dashboard_manage_server}}</a>
				{{/isAdmin}}
				<form action="/logout" method="get" class="logout-form">
					<button type="submit" class="logout-button">{{msg.admin_logout_button}}</button>
				</form>
			</div>
		</div>

		<!-- Projects Section -->
		<section class="paper-section">
			<div class="section-header">
				<h2 class="section-header__title">{{msg.dashboard_projects_title}}</h2>
			</div>
			<p class="section-description">{{msg.dashboard_projects_description}}</p>

			<div class="projects-container">
				<div id="projects-list-container">
					{{> partials/projects}}
				</div>
			</div>
		</section>

		<!-- Account Section -->
		<section class="paper-section">
			<div class="section-header">
				<h2 class="section-header__title">{{msg.dashboard_account_title}}</h2>
			</div>
			<div class="account-container">
				<div class="account-info">
					<p><strong>{{msg.dashboard_account_email}}:</strong> {{email}}</p>
					<p><strong>{{msg.dashboard_account_created}}:</strong> {{accountCreated}}</p>
					<div class="pen-name-section" id="pen-name-section"
						 data-has-penname="{{#penName}}true{{/penName}}{{^penName}}false{{/penName}}"
						 data-label="{{msg.penname_label}}">
						<p class="pen-name-header"><strong>{{msg.penname_label}}</strong></p>
						{{> penname-display}}
						{{> penname-edit}}
						{{> penname-release}}
					</div>
				</div>
			</div>
		</section>
	</div>
</main>

{{> footer}}
