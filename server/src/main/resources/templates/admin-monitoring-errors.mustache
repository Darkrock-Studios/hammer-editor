{{> header}}

<link rel="stylesheet" href="/assets/css/monitoring.css">

<main class="page">
	<div class="admin-layout">
		{{> partials/admin-nav}}

		<div class="admin-content">
			<div class="page-header">
				<div class="page-header__content">
					<h1 class="page-header__title">{{msg.admin_mon_errors_title}}</h1>
					<p class="page-header__subtitle">{{msg.admin_mon_errors_subtitle}}</p>
				</div>
			</div>

			{{> partials/monitoring-nav}}

			<section class="paper-section">
				<div class="section-header">
					<h2 class="section-header__title">{{msg.admin_mon_perf_error_rate_title}}</h2>
					<div class="section-header__actions mon-range">
						<a class="mon-range__btn {{#range24h}}mon-range__btn--active{{/range24h}}"
						   href="/admin/monitoring/errors?range=24h{{#hasRouteFilter}}&route={{routeFilterEnc}}{{/hasRouteFilter}}">{{msg.admin_mon_range_24h}}</a>
						<a class="mon-range__btn {{#range7d}}mon-range__btn--active{{/range7d}}"
						   href="/admin/monitoring/errors?range=7d{{#hasRouteFilter}}&route={{routeFilterEnc}}{{/hasRouteFilter}}">{{msg.admin_mon_range_7d}}</a>
						<a class="mon-range__btn {{#range30d}}mon-range__btn--active{{/range30d}}"
						   href="/admin/monitoring/errors?range=30d{{#hasRouteFilter}}&route={{routeFilterEnc}}{{/hasRouteFilter}}">{{msg.admin_mon_range_30d}}</a>
					</div>
				</div>
				<div class="mon-chart" id="mon-error-rate-chart"></div>
			</section>

			<section class="paper-section">
				<div class="section-header">
					<h2 class="section-header__title">{{msg.admin_mon_errors_grouped}}</h2>
					{{#hasErrors}}
						<div class="section-header__actions">
							<a class="mon-range__btn" href="/admin/monitoring/errors/export{{#hasRouteFilter}}?route={{routeFilterEnc}}{{/hasRouteFilter}}">
								<i class="fa-solid fa-download"></i> {{msg.admin_mon_errors_export}}
							</a>
						</div>
					{{/hasErrors}}
				</div>

				{{#hasRouteFilter}}
					<div class="mon-filter-chip">
						<span class="mon-filter-chip__label">{{msg.admin_mon_errors_filtered_by}}</span>
						<code class="mon-filter-chip__value">{{routeFilter}}</code>
						<a class="mon-filter-chip__clear" href="/admin/monitoring/errors?range={{range}}" title="{{msg.admin_mon_errors_filter_clear}}">
							<i class="fa-solid fa-xmark"></i> {{msg.admin_mon_errors_filter_clear}}
						</a>
					</div>
				{{/hasRouteFilter}}

				{{#hasErrors}}
					<div class="mon-error-list">
						{{#errors}}
							{{> partials/mon-error-row}}
						{{/errors}}
					</div>

					{{#isPaged}}
						<div class="pagination">
							{{#hasPrev}}
								<a class="pagination-button" href="/admin/monitoring/errors?range={{range}}&page={{prevPage}}{{#hasRouteFilter}}&route={{routeFilterEnc}}{{/hasRouteFilter}}">&laquo; {{msg.admin_pagination_prev}}</a>
							{{/hasPrev}}
							<span class="pagination-info">{{msg.admin_pagination_page}} {{currentPageDisplay}} {{msg.admin_pagination_of}} {{totalPages}}</span>
							{{#hasNext}}
								<a class="pagination-button" href="/admin/monitoring/errors?range={{range}}&page={{nextPage}}{{#hasRouteFilter}}&route={{routeFilterEnc}}{{/hasRouteFilter}}">{{msg.admin_pagination_next}} &raquo;</a>
							{{/hasNext}}
						</div>
					{{/isPaged}}
				{{/hasErrors}}
				{{^hasErrors}}
					<div class="mon-nominal">
						<i class="fa-solid fa-circle-check"></i>
						<span>{{msg.admin_mon_errors_none}}</span>
					</div>
				{{/hasErrors}}
			</section>

			<section class="paper-section">
				<details class="mon-ignored">
					<summary class="mon-ignored__summary">
						<i class="fa-solid fa-chevron-right mon-ignored__chevron"
						   aria-hidden="true"></i>
						<h2 class="mon-ignored__title">{{msg.admin_mon_errors_ignored_section}}</h2>
						<span class="mon-ignored__count">{{ignoredCount}}</span>
					</summary>

					<p class="section-description">{{msg.admin_mon_errors_ignored_help}}</p>

					{{#hasIgnoreRules}}
						<div class="mon-ignore-rules">
							<span
								class="mon-ignore-rules__label">{{msg.admin_mon_errors_rules_label}}</span>
							{{#ignoreRules}}
								<form class="mon-rule-chip"
								      hx-post="/admin/monitoring/errors/unignore" hx-swap="none">
									<input type="hidden" name="type" value="{{type}}">
									{{#hasGlob}}<input type="hidden" name="routeGlob"
									                   value="{{glob}}">{{/hasGlob}}
									<span class="mon-rule-chip__type">{{type}}</span>
									{{#hasGlob}}<span
										class="mon-rule-chip__glob">{{glob}}</span>{{/hasGlob}}
									<button type="submit" class="mon-rule-chip__remove"
									        title="{{msg.admin_mon_errors_rule_remove}}"
									        aria-label="{{msg.admin_mon_errors_rule_remove}}">
										<i class="fa-solid fa-xmark"></i>
									</button>
								</form>
							{{/ignoreRules}}
						</div>
					{{/hasIgnoreRules}}

					<form class="mon-rule-add" hx-post="/admin/monitoring/errors/ignore"
					      hx-swap="none">
						<input type="text" class="form-input mon-rule-add__type" name="type"
						       placeholder="{{msg.admin_mon_errors_rule_type_placeholder}}"
						       required>
						<input type="text" class="form-input mon-rule-add__glob" name="routeGlob"
						       placeholder="{{msg.admin_mon_errors_rule_route_placeholder}}">
						<button type="submit" class="btn">{{msg.admin_mon_errors_rule_add}}</button>
					</form>

					{{#hasIgnoredErrors}}
						<div class="mon-error-list mon-error-list--ignored">
							{{#ignoredErrors}}
								{{> partials/mon-error-row}}
							{{/ignoredErrors}}
						</div>
						{{#ignoredTruncated}}
							<p class="mon-ignored__truncated">{{msg.admin_mon_errors_ignored_truncated}}</p>
						{{/ignoredTruncated}}
					{{/hasIgnoredErrors}}
				</details>
			</section>
		</div>
	</div>
</main>

<script src="/assets/js/frappe-charts.min.js"></script>
<script>
	(function () {
		var data = {{{errorRateChartJson}}};
		var el = document.getElementById("mon-error-rate-chart");
		if (!el || !data.labels || data.labels.length < 2) {
			if (el) el.innerHTML = '<p class="mon-chart__empty">{{msg.admin_mon_no_data}}</p>';
			return;
		}
		var ChartCtor = (window.frappe && window.frappe.Chart) || window.Chart;
		if (!ChartCtor) return;
		new ChartCtor(el, {
			data: {
				labels: data.labels,
				datasets: [{ name: "{{msg.admin_mon_perf_error_rate_label}}", values: data.errorRates }]
			},
			type: "line",
			height: 120,
			colors: ["#ef4444"],
			axisOptions: { xAxisMode: "tick", xIsSeries: true },
			lineOptions: { hideDots: 1, regionFill: 1 },
			tooltipOptions: { formatTooltipY: function(v) { return v != null ? v.toFixed(1) + "%" : ""; } }
		});
	})();
</script>

{{> footer}}
