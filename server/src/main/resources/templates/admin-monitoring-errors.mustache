{{> header}}

<link rel="stylesheet" href="/assets/css/monitoring.css">

<main class="page">
	<div class="admin-layout">
		{{> partials/admin-nav}}

		<div class="admin-content">
			<div class="page-header">
				<div class="page-header__content">
					<h1 class="page-header__title">{{msg.admin_mon_errors_title}}</h1>
					<p class="page-header__subtitle">{{msg.admin_mon_errors_subtitle}}</p>
				</div>
			</div>

			{{> partials/monitoring-nav}}

			<section class="paper-section">
				<div class="section-header">
					<h2 class="section-header__title">{{msg.admin_mon_errors_grouped}}</h2>
				</div>

				{{#hasErrors}}
					<div class="mon-error-list">
						{{#errors}}
							<details class="mon-error">
								<summary class="mon-error__summary">
									<span class="mon-error__count">{{count}}&times;</span>
									<span class="mon-error__type">{{type}}</span>
									<span class="mon-error__route">{{route}}</span>
									<span class="mon-error__meta">
										{{#hasUser}}<span class="mon-error__user"><i class="fa-solid fa-user"></i> {{user}}</span>{{/hasUser}}
										<span class="mon-error__seen">{{lastSeen}}</span>
									</span>
								</summary>
								<div class="mon-error__body">
									{{#hasMessage}}<p class="mon-error__message">{{message}}</p>{{/hasMessage}}
									{{#hasStack}}<pre class="mon-error__stack">{{stackTrace}}</pre>{{/hasStack}}
								</div>
							</details>
						{{/errors}}
					</div>

					{{#isPaged}}
						<div class="pagination">
							{{#hasPrev}}
								<a class="pagination-button" href="/admin/monitoring/errors?page={{prevPage}}">&laquo; {{msg.admin_pagination_prev}}</a>
							{{/hasPrev}}
							<span class="pagination-info">{{msg.admin_pagination_page}} {{currentPageDisplay}} {{msg.admin_pagination_of}} {{totalPages}}</span>
							{{#hasNext}}
								<a class="pagination-button" href="/admin/monitoring/errors?page={{nextPage}}">{{msg.admin_pagination_next}} &raquo;</a>
							{{/hasNext}}
						</div>
					{{/isPaged}}
				{{/hasErrors}}
				{{^hasErrors}}
					<div class="mon-nominal">
						<i class="fa-solid fa-circle-check"></i>
						<span>{{msg.admin_mon_errors_none}}</span>
					</div>
				{{/hasErrors}}
			</section>
		</div>
	</div>
</main>

{{> footer}}
