CREATE TABLE writing_activity (
	user_id INTEGER NOT NULL,
	project_id INTEGER NOT NULL,
	device_id TEXT NOT NULL CHECK (device_id != ''),
	content TEXT NOT NULL,
	FOREIGN KEY(user_id) REFERENCES account(id),
	FOREIGN KEY(project_id) REFERENCES project(id) ON DELETE CASCADE,
	UNIQUE(user_id, project_id, device_id)
);

getAllForProject:
SELECT device_id, content
FROM writing_activity
WHERE user_id = :userId AND project_id = :projectId;

upsertDeviceLog:
INSERT OR REPLACE INTO writing_activity(user_id, project_id, device_id, content)
VALUES (:userId, :projectId, :deviceId, :content);

-- Used only by SqliteToPostgresMigrator. (getAllForProject above projects to
-- only device_id+content; the migrator needs the full row.)
getAllForMigration:
SELECT * FROM writing_activity ORDER BY user_id, project_id, device_id;
